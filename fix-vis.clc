.axes.draw_artist(a)\n  File \"/home/fanshu/Workspace/qianli_auto_aim_simulation/.venv/lib/python3.11/site-packages/matplotlib/axes/_base.py\", line 3382, in draw_artist\n    a.draw(self.get_figure(root=True).canvas.get_renderer())\n  File \"/home/fanshu/Workspace/qianli_auto_aim_simulation/.venv/lib/python3.11/site-packages/matplotlib/artist.py\", line 71, in draw_wrapper\n    return draw(artist, renderer)\n           ^^^^^^^^^^^^^^^^^^^^^^\n  File \"/home/fanshu/Workspace/qianli_auto_aim_simulation/.venv/lib/python3.11/site-packages/matplotlib/text.py\", line 909, in draw\n    textrenderer.draw_text(gc, x, y, clean_line,\n  File \"/home/fanshu/Workspace/qianli_auto_aim_simulation/.venv/lib/python3.11/site-packages/matplotlib/backends/backend_agg.py\", line 245, in draw_text\n    self._draw_text_glyphs_and_boxes(\n  File \"/home/fanshu/Workspace/qianli_auto_aim_simulation/.venv/lib/python3.11/site-packages/matplotlib/backends/backend_agg.py\", line 189, in _draw_text_glyphs_and_boxes\n    bitmap = font._render_glyph(\n             ^^^^^^^^^^^^^^^^^^^\nRuntimeError: FT_Render_Glyph (ft2font_wrapper.cpp line 1947) failed with error 0x62: raster overflow\n这是怎么回事"}
