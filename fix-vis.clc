{"type": "tool_result", "timestamp": 1793176800.6506937, "id": "d542d25f5677", "tool_call_id": "call_00_NFLJEHs2dMe1XBCzWNnS4264", "content": "96:         ax_img.add_patch(fill)\n97:         art[\"fills\"].append(fill)\n98:         art[\"edges\"].append(ax_img.plot([], [], color=ARMOR_COLORS[m], lw=1.2,\n99:                                         zorder=2)[0])\n100:         art[\"tags\"].append(ax_img.text(0.0, 0.0, f\"A{m}\", fontsize=8, zorder=3))\n101: \n102:     apply_cube(ax, fixed[\"ax\"])\n103:     apply_cube(ax2, fixed[\"ax2\"])\n104:     ax_img.set_xlim(fixed[\"img\"][0], fixed[\"img\"][1])\n105:     ax_img.set_ylim(fixed[\"img\"][2], fixed[\"img\"][3])\n106:     ax_img.set_aspect(\"equal\")\n107:     ax_img.grid(alpha=0.3)\n108:     for a in (ax, ax2, ax_img):\n109:         a.set_autoscale_on(False)      # one scale for the whole clip\n110:     return art\n111: \n112: \n113: def draw(index, out, args, art, n_armors):\n114:     \"\"\"point every artist at frame *index*: nothing created, nothing cleared.\"\"\"\n115:     centers = out[\"centers\"][0, index].numpy()\n116:     corners = out[\"corners\"][0, index].numpy()          # (M, 4, 3)\n117:     body_rot = out[\"body_rotations\"][0, index].numpy()\n118:     armor_rot = out[\"armor_rotations\"][0, index].numpy()\n119: \n120:     cam_pos = np.array([0.0, 0.0, args.height])\n121:     body = np.array([args.distance, 0.0, args.height])\n122:     R_wc = camera_rotation(args.cam_yaw)\n123: \n124:     # panel 1: world, camera and body frames, true scale\n125:     for k, (origin, rot, length) in enumerate((\n126:             (np.zeros(3), np.eye(3), 0.5),\n127:             (cam_pos, R_wc.T, 0.3),\n128:             (body, body_rot, 0.25))):\n129:         for j, line in enumerate(art[\"frames\"][k]):\n130:             line.set_data_3d(*segment(origin, origin + length * rot[:, j]))\n131:         art[\"labels\"][k].set_position_3d(origin)\n132:     for m in range(n_armors):\n133:         art[\"plates\"][m].set_data_3d(*np.vstack([corners[m], corners[m, 0]]).T)\n134: \n135:     # panel 2: body and armor frames, close up\n136:     close = [(body, body_rot, 0.2)] + [(centers[m], armor_rot[m], 0.1)\n137:                                        for m in range(n_armors)]\n138:     for k, (origin, rot, length) in enumerate(close):\n139:         for j, line in enumerate(art[\"frames2\"][k]):\n140:             line.set_data_3d(*segment(origin, origin + length * rot[:, j]))\n141:         art[\"labels2\"][k].set_position_3d(origin)\n142:     for m in range(n_armors):\n143:         art[\"plates2\"][m].set_data_3d(*np.vstack([corners[m], corners[m, 0]]).T)\n144: \n145:     # panel 3: camera view; solid = front face, dotted = back\n146:     w, h = args.image_size\n147:     u, v, _ = project(corners, R_wc, cam_pos, args.fx, args.fx, w / 2, h / 2)\n148:     normal = np.cross(corners[:, 1] - corners[:, 0], corners[:, 3] - corners[:, 0])\n149:     normal /= np.linalg.norm(normal, axis=-1, keepdims=True)\n150:     front = (normal * (cam_pos - centers)).sum(-1) > 0\n151:     for m in range(n_armors):\n152:         loop = np.column_stack([np.append(u[m], u[m, 0]), np.append(v[m], v[m, 0])])\n153:         art[\"fills\"][m].set_xy(loop)\n154:         art[\"fills\"][m].set_visible(bool(front[m]))\n155:         art[\"edges\"][m].set_data(loop[:, 0], loop[:, 1])\n156:         art[\"edges\"][m].set_linestyle(\"-\" if front[m] else \":\")\n157:         art[\"tags\"][m].set_position((u[m].mean(), v[m].mean()))\n158: \n159: \n160: def main(argv=None) -> int:\n161:     p = argparse.ArgumentParser(description=__doc__)\n162:     p.add_argument(\"--distance\", type=float, default=3.0, help=\"target distance (m)\")\n163:     p.add_argument(\"--height\", type=float, default=0.5, help=\"target/camera height (m)\")\n164:     p.add_argument(\"--radius\", type=float, default=0.3)\n165:     p.add_argument(\"--yaw\", type=float, default=0.0, help=\"target yaw (deg)\")\n166:     p.add_argument(\"--cam-yaw\", type=float, default=0.0,\n167:                    help=\"camera yaw (deg), positive looks left\")\n168:     p.add_argument(\"--fx\", type=float, default=800.0)\n169:     p.add_argument(\"--image-size\", type=int, nargs=2, default=[1280, 1024],\n170:                    metavar=(\"W\", \"H\"))\n171:     p.add_argument(\"--dpi\", type=int, default=100)\n172:     p.add_argument(\"--duration\", type=float, default=10.0)\n173:     p.add_argument(\"--fps\", type=float, default=60.0)\n174:     args = p.parse_args(argv)\n175:     if args.duration <= 0 or args.fps <= 0:\n176:         p.error(\"--duration and --fps must be positive\")\n177: \n178:     n_armors = 4\n179:     n_frames = max(2, int(round(args.duration * args.fps)))\n180:     t = torch.linspace(0.0, args.duration, n_frames).unsqueeze(0)\n... (showing lines 96-180 of 248; use offset=181 to continue)", "is_error": false, "diff": ""}
