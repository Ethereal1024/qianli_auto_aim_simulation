{"type": "tool_result", "timestamp": 1793174632.2662623, "id": "0c2b3d4b3af1", "tool_call_id": "call_00_5fm538AsHlTLwtQMIGnR0363", "content": "OK: command succeeded\nstdout:\ndiff --git a/scripts/visualize_target.py b/scripts/visualize_target.py\nindex f68ff75..dbe89d9 100644\n--- a/scripts/visualize_target.py\n+++ b/scripts/visualize_target.py\n@@ -9,10 +9,6 @@ frame axes: x red, y green, z blue\n import argparse\n import math\n \n-import matplotlib\n-\n-matplotlib.use(\"Agg\")\n-\n import matplotlib.pyplot as plt\n import numpy as np\n import torch\n@@ -62,52 +58,29 @@ def label_axes(ax):\n     ax.set_ylabel(\"Y left (m)\")\n     ax.set_zlabel(\"Z up (m)\")\n \n-\n-def main(argv=None) -> int:\n-    p = argparse.ArgumentParser(description=__doc__)\n-    p.add_argument(\"--out\", default=\"scripts/target_vis.png\")\n-    p.add_argument(\"--distance\", type=float, default=3.0, help=\"target distance (m)\")\n-    p.add_argument(\"--height\", type=float, default=0.5, help=\"target/camera height (m)\")\n-    p.add_argument(\"--radius\", type=float, default=0.3)\n-    p.add_argument(\"--yaw\", type=float, default=0.0, help=\"target yaw (deg)\")\n-    p.add_argument(\"--cam-yaw\", type=float, default=0.0,\n-                   help=\"camera yaw (deg), positive looks left\")\n-    p.add_argument(\"--fx\", type=float, default=800.0)\n-    p.add_argument(\"--image-size\", type=int, nargs=2, default=[1280, 1024],\n-                   metavar=(\"W\", \"H\"))\n-    p.add_argument(\"--dpi\", type=int, default=130)\n-    args = p.parse_args(argv)\n-\n-    # one snapshot of the target\n-    out = TargetMotion()(\n-        torch.zeros(1, 1),\n-        \"complex\",\n-        p0=torch.tensor([[args.distance, 0.0, args.height]]),\n-        yaw_0=torch.tensor([math.radians(args.yaw)]),\n-        n_armors=4,\n-        radius=torch.tensor([args.radius]),\n-    )\n-    centers = out[\"centers\"][0, 0].numpy()\n-    corners = out[\"corners\"][0, 0].numpy()          # (M, 4, 3)\n-    body_rot = out[\"body_rotations\"][0, 0].numpy()\n-    armor_rot = out[\"armor_rotations\"][0, 0].numpy()\n+def update(index: int, out: dict, args, fig, ax, ax2, ax_img):\n+    centers = out[\"centers\"][0, index].numpy()\n+    corners = out[\"corners\"][0, index].numpy()          # (M, 4, 3)\n+    body_rot = out[\"body_rotations\"][0, index].numpy()\n+    armor_rot = out[\"armor_rotations\"][0, index].numpy()\n+    \n+    ax.clear()\n+    ax2.clear()\n+    ax_img.clear()\n \n     w, h = args.image_size\n     cam_pos = np.array([0.0, 0.0, args.height])\n     body = np.array([args.distance, 0.0, args.height])\n     R_wc = camera_rotation(args.cam_yaw)\n     u, v, depth = project(corners, R_wc, cam_pos, args.fx, args.fx, w / 2, h / 2)\n-    assert (depth > 0).all(), \"target is behind the came\n... [1573 chars omitted] ...\n)\n     ax_img.grid(alpha=0.3)\n     ax_img.set_title(f\"camera view at {args.distance:.1f} m \"\n-                     f\"({w}x{h}, fx={args.fx:.0f}, zoom)\")\n+                        f\"({w}x{h}, fx={args.fx:.0f}, zoom)\")\n \n     fig.suptitle(\"W world, C camera, B body, A# armor;  x red, y green, z blue\",\n-                 fontsize=9)\n-    fig.tight_layout(rect=(0, 0, 1, 0.95))\n-    fig.savefig(args.out, dpi=args.dpi)\n-    print(f\"saved -> {args.out}\")\n+                    fontsize=9)\n+    return []\n+\n+def main(argv=None) -> int:\n+    p = argparse.ArgumentParser(description=__doc__)\n+    p.add_argument(\"--out\", default=\"scripts/target_vis.png\")\n+    p.add_argument(\"--distance\", type=float, default=3.0, help=\"target distance (m)\")\n+    p.add_argument(\"--height\", type=float, default=0.5, help=\"target/camera height (m)\")\n+    p.add_argument(\"--radius\", type=float, default=0.3)\n+    p.add_argument(\"--yaw\", type=float, default=0.0, help=\"target yaw (deg)\")\n+    p.add_argument(\"--cam-yaw\", type=float, default=0.0,\n+                   help=\"camera yaw (deg), positive looks left\")\n+    p.add_argument(\"--fx\", type=float, default=800.0)\n+    p.add_argument(\"--image-size\", type=int, nargs=2, default=[1280, 1024],\n+                   metavar=(\"W\", \"H\"))\n+    p.add_argument(\"--dpi\", type=int, default=130)\n+    p.add_argument(\"--duration\", type=float, default=10.0)\n+    p.add_argument(\"--fps\", type=int, default=10.0)\n+    args = p.parse_args(argv)\n+    \n+    n_frames = int(args.duration * args.fps)\n+    t = torch.linspace(0.0, args.duration, n_frames).unsqueeze(0)\n+\n+    # one snapshot of the target\n+    out = TargetMotion()(\n+        t,\n+        \"complex\",\n+        p0=torch.tensor([[args.distance, 0.0, args.height]]),\n+        yaw_0=torch.tensor([math.radians(args.yaw)]),\n+        yaw_rate=torch.tensor([3]),\n+        n_armors=4,\n+        radius=torch.tensor([args.radius]),\n+    )\n+    \n+    fig = plt.figure(figsize=(16.5, 5.2))\n+    # ax     = fig.add_subplot(1, 3, 1, projection=\"3d\")\n+    ax2    = fig.add_subplot(1, 3, 2, projection=\"3d\")\n+    ax_img = fig.add_subplot(1, 3, 3)\n+    \n+    fig.subplots_adjust(left=0.04, right=0.98, bottom=0.10, top=0.85, wspace=0.15)\n+    \n+    from matplotlib.animation import FuncAnimation\n+    ani = FuncAnimation(\n+        fig, \n+        lambda i: update(i, out, args, fig, ax, ax2, ax_img),\n+        frames=n_frames,\n+        interval=1000.0 / args.fps,\n+        blit=False,\n+        repeat=False\n+    )\n+    \n+    plt.show()\n     return 0\n \n \n", "is_error": false, "diff": ""}
