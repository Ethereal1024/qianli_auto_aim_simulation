{"type": "tool_call", "timestamp": 1792652587.8362274, "id": "aacbf5f44fd7", "name": "run_command", "arguments": "{\"command\": \"cat diff_env/geometry.py diff_env/camera.py\"}", "tool_call_id": "call_01_ET_8NIxB4YTdeZYP93Lojq40666", "ui": {"group": null, "chip": "name", "summary": "", "preview": "command", "header": "", "form": "block", "body": "text", "collapse": "never", "highlight": "", "chrome": "", "mutates": true, "undo": false}, "path_arg": ""}
{"type": "tool_result", "timestamp": 1792652587.8490424, "id": "1b3d2210ca9b", "tool_call_id": "call_00_ET_QsXaV187t1BDnXwfZ55a3649", "content": "OK: command succeeded\nstdout:\nimport math\n\nimport torch\nfrom torch import nn\n\nfrom diff_env.geometry import euler_to_rotmat\n\n\nclass BodyMotion(nn.Module):\n    def forward(self, t: torch.Tensor, params: dict):\n        bsz, sln = t.shape\n        device = t.device\n\n        def _get(key: str, shape: tuple, default: float = 0.0):\n            val = params.get(key, None)\n            if val is None:\n                return torch.full(shape, default, device=device, dtype=t.dtype)\n            if isinstance(val, torch.Tensor):\n                return val.to(device=device, dtype=t.dtype)\n            return torch.full(shape, float(val), device=device, dtype=t.dtype)\n\n        t_e = t.unsqueeze(-1)\n\n        p0 = _get(\"p0\", (bsz, 3))\n        v = _get(\"v\", (bsz, 3))\n        a = _get(\"a\", (bsz, 3))\n        sinus_amp = _get(\"sinus_amp\", (bsz, 3))\n        sinus_freq = _get(\"sinus_freq\", (bsz, 3))\n        rw_sigma = _get(\"rw_sigma\", (bsz, 3))\n\n        pos = p0.unsqueeze(1) + v.unsqueeze(1) * t_e + 0.5 * a.unsqueeze(1) * t_e**2\n\n        if sinus_amp.abs().sum() > 0:\n            pos = pos + sinus_amp.unsqueeze(1) * torch.sin(\n                2 * math.pi * sinus_freq.unsqueeze(1) * t_e\n            )\n\n        if rw_sigma.abs().sum() > 0:\n            increments = torch.randn(\n                bsz, sln, 3, device=device, dtype=t.dtype\n            ) * rw_sigma.unsqueeze(1)\n            pos = pos + torch.cumsum(increments, dim=1)\n\n        yaw_0 = _get(\"yaw_0\", (bsz,))\n        yaw_rate = _get(\"yaw_rate\", (bsz,))\n        yaw_amp = _get(\"yaw_amp\", (bsz,))\n        yaw_freq = _get(\"yaw_freq\", (bsz,))\n\n        pitch_0 = _get(\"pitch_0\", (bsz,))\n        pitch_amp = _get(\"pitch_amp\", (bsz,))\n        pitch_freq = _get(\"pitch_freq\", (bsz,))\n\n        roll_0 = _get(\"roll_0\", (bsz,))\n        roll_amp = _get(\"roll_amp\", (bsz,))\n        roll_freq = _get(\"roll_freq\", (bsz,))\n\n        yaw = yaw_0.unsqueeze(1) + yaw_rate.unsqueeze(1) * t\n        if yaw_amp.abs().sum() > 0:\n            yaw = yaw + yaw_amp.unsqueeze(1) * torch.sin(\n                2 * math.pi * yaw_freq.unsqueeze(1) * t\n            )\n\n        pitch = pitch_0.unsqueeze(1).expand(-1, sln)\n        if pitch_amp.abs().sum() > 0:\n            pitch = pitch + pitch_amp.unsqueeze(1) * torch.sin(\n                2 * math.pi * pitch_freq.unsqueeze(1) * t\n            )\n\n        roll = roll_0.unsqueeze(1).expand(-1, sln)\n        if roll_amp.abs().sum() > 0:\n            roll = roll + roll_amp.unsqueeze(1) * torch.sin(\n                2 * math.pi * roll_freq.unsqueeze(1) * t\n           \n... [1224 chars omitted] ...\n  * 2\n            * math.pi\n            / n_armors\n        )\n\n        r_eff = radius.unsqueeze(-1) + radius_offsets\n        local_x = r_eff * torch.cos(theta)\n        local_y = r_eff * torch.sin(theta)\n        local_z = height_offsets\n        local_positions = torch.stack([local_x, local_y, local_z], dim=-1)\n\n        yaws = theta.unsqueeze(0).expand(bsz, -1)\n        zeros = torch.zeros_like(yaws)\n        local_rotations = euler_to_rotmat(yaws, armor_pitch, zeros)\n\n        w2 = self.armor_width / 2\n        h2 = self.armor_height / 2\n        corners_local = torch.tensor(\n            [\n                [-w2, -h2, 0.0],\n                [w2, -h2, 0.0],\n                [w2, h2, 0.0],\n                [-w2, h2, 0.0],\n            ],\n            device=device,\n            dtype=radius.dtype,\n        )\n\n        return local_positions, local_rotations, corners_local\n\n\nclass TargetMotion(nn.Module):\n    def __init__(self, armor_width: float = 0.12, armor_height: float = 0.06):\n        super().__init__()\n        self.body_motion = BodyMotion()\n        self.armor_layout = ArmorLayout(armor_width, armor_height)\n\n    def forward(self, t, mode=\"static\", **params):\n        bsz, _ = t.shape\n        device = t.device\n\n        if mode in (\"static\", \"constant_velocity\"):\n            n_armors = 1\n        else:\n            n_armors = params.get(\"n_armors\", 4)\n\n        radius = params.get(\"radius\", None)\n        if radius is None:\n            radius = torch.full((bsz,), 0.2, device=device, dtype=t.dtype)\n        elif not isinstance(radius, torch.Tensor):\n            radius = torch.full((bsz,), float(radius), device=device, dtype=t.dtype)\n\n        radius_offsets = params.get(\"armor_radius_offsets\", None)\n        height_offsets = params.get(\"armor_height_offsets\", None)\n\n        body = self.body_motion(t, params)\n        body_pos = body[\"positions\"]\n        body_rot = body[\"rotations\"]\n\n        local_pos, local_rot, corners_local = self.armor_layout(\n            n_armors, radius, radius_offsets, height_offsets\n        )\n\n        centers = body_pos.unsqueeze(2) + torch.einsum(\n            \"btij,bmj->btmi\", body_rot, local_pos\n        )\n        world_rot = torch.einsum(\"btik,bmkj->btmij\", body_rot, local_rot)\n        corners = centers.unsqueeze(-2) + torch.einsum(\n            \"btmij,cj->btmci\", world_rot, corners_local\n        )\n        armor_yaws = torch.atan2(world_rot[..., 1, 0], world_rot[..., 0, 0])\n\n        return {\"corners\": corners, \"centers\": centers, \"armor_yaws\": armor_yaws}\n", "is_error": false, "diff": ""}
{"type": "tool_result", "timestamp": 1792652587.861916, "id": "d82b0104d72e", "tool_call_id": "call_01_ET_8NIxB4YTdeZYP93Lojq40666", "content": "OK: command succeeded\nstdout:\nimport torch\n\n\ndef euler_to_rotmat(\n    yaw: torch.Tensor, pitch: torch.Tensor, roll: torch.Tensor\n) -> torch.Tensor:\n    cy, sy = torch.cos(yaw), torch.sin(yaw)\n    cp, sp = torch.cos(pitch), torch.sin(pitch)\n    cr, sr = torch.cos(roll), torch.sin(roll)\n\n    zero = torch.zeros_like(cy)\n    one = torch.ones_like(cy)\n\n    Rz = torch.stack(\n        [\n            torch.stack([cy, -sy, zero], dim=-1),\n            torch.stack([sy, cy, zero], dim=-1),\n            torch.stack([zero, zero, one], dim=-1),\n        ],\n        dim=-2,\n    )\n\n    Ry = torch.stack(\n        [\n            torch.stack([cp, zero, sp], dim=-1),\n            torch.stack([zero, one, zero], dim=-1),\n            torch.stack([-sp, zero, cp], dim=-1),\n        ],\n        dim=-2,\n    )\n\n    Rx = torch.stack(\n        [\n            torch.stack([one, zero, zero], dim=-1),\n            torch.stack([zero, cr, -sr], dim=-1),\n            torch.stack([zero, sr, cr], dim=-1),\n        ],\n        dim=-2,\n    )\n\n    return Rz @ Ry @ Rx\n\n\ndef rvec_to_rotmat(rvec: torch.Tensor, eps: float = 1e-8) -> torch.Tensor:\n    theta = torch.norm(rvec, dim=-1, keepdim=True).clamp_min(eps)\n    k = rvec / theta\n\n    K = torch.zeros(*rvec.shape[:-1], 3, 3, device=rvec.device, dtype=rvec.dtype)\n    K[..., 0, 1] = -k[..., 2]\n    K[..., 0, 2] = k[..., 1]\n    K[..., 1, 0] = k[..., 2]\n    K[..., 1, 2] = -k[..., 0]\n    K[..., 2, 0] = -k[..., 1]\n    K[..., 2, 1] = k[..., 0]\n\n    sin_t = torch.sin(theta).unsqueeze(-1)\n    cos_t = torch.cos(theta).unsqueeze(-1)\n    I = torch.eye(3, device=rvec.device, dtype=rvec.dtype).expand_as(K)\n\n    R = I + sin_t * K + (1.0 - cos_t) * (K @ K)\n    return R\n\n\ndef apply_transform(\n    R: torch.Tensor, t: torch.Tensor, points: torch.Tensor\n) -> torch.Tensor:\n    rotated = points @ R.mT\n    return rotated + t.unsqueeze(-2)\n\n\ndef project_to_normalized(points_cam: torch.Tensor, eps: float = 1e-6) -> torch.Tensor:\n    z = points_cam[..., 2:3].clamp_min(eps)\n    xn = points_cam[..., 0:1] / z\n    yn = points_cam[..., 1:2] / z\n    return torch.cat([xn, yn], dim=-1)\n\n\ndef compute_az_el(points_gimbal: torch.Tensor, eps: float = 1e-8) -> torch.Tensor:\n    x = points_gimbal[..., 0]\n    y = points_gimbal[..., 1]\n    z = points_gimbal[..., 2]\n\n    az = torch.atan2(x, y)\n    horizontal = torch.sqrt(x * x + y * y).clamp_min(eps)\n    el = torch.atan2(z, horizontal)\n    return torch.stack([az, el], dim=-1)\nimport torch\nfrom torch import nn\n\nfrom diff_env.geometry import project_to_normalized, rvec_to_rotmat\n\n\nclass Camera(nn.Module):\n    def forward(\n        self,\n        points_gimbal: torch.Tensor,\n        rvec_cg: torch.Tensor,\n        t_cg: torch.Tensor,\n        eps: float = 1e-6,\n    ):\n        R_cg = rvec_to_rotmat(rvec_cg)\n        \n        delta = points_gimbal - t_cg.unsqueeze(-2)\n        points_cam = delta @ R_cg.mT\n        \n        valid = points_cam[..., 2] > eps\n        \n        keypoints = project_to_normalized(points_cam, eps)\n        return keypoints, valid\n", "is_error": false, "diff": ""}
