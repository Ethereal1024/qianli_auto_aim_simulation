{"type": "tool_result", "timestamp": 1792654289.9134195, "id": "dc8edea33c1b", "tool_call_id": "call_00_jI4wKZSXlyIbnb5OHhCr0247", "content": "OK: command succeeded\nstdout:\n# --------------------------------------------------------------------------- #\n# figure\n# --------------------------------------------------------------------------- #\ndef build_figure(scene: dict, cam: Pinhole, cam_pos: np.ndarray, cam_yaw: float,\n                 n_frames: int, note: str = \"\"):\n    T, M = scene[\"corners\"].shape[:2]\n    n_frames = int(np.clip(n_frames, 1, T))\n    frame_idx = np.unique(np.linspace(0, T - 1, n_frames).round().astype(int))\n    R_wc = camera_from_world(cam_yaw)\n\n    centers, corners = scene[\"centers\"], scene[\"corners\"]\n    cos = facing_cos(centers, face_normals(corners), cam_pos)\n    colors = [BASE_COLORS[m % len(BASE_COLORS)] for m in range(M)]\n\n    fig = plt.figure(figsize=(17.0, 6.4))\n\n    # ---------------- panel 1: global overview (camera + target) ------------\n    ax_g = fig.add_subplot(1, 3, 1, projection=\"3d\")\n    ax_g.scatter(*cam_pos, c=\"k\", marker=\"^\", s=90, label=\"camera\")\n    sight = np.vstack([cam_pos, scene[\"body\"]])\n    dist = float(np.linalg.norm(scene[\"body\"] - cam_pos))\n    ax_g.plot(sight[:, 0], sight[:, 1], sight[:, 2], \"k--\", lw=1.0, alpha=0.6,\n              label=f\"line of sight {dist:.2f} m\")\n    ax_g.plot(centers[:, :, 0].ravel(), centers[:, :, 1].ravel(),\n              centers[:, :, 2].ravel(), \".\", ms=2, c=\"#555555\", alpha=0.5)\n    set_equal_3d(ax_g, np.vstack([corners.reshape(-1, 3), cam_pos[None]]), pad=0.05)\n    _draw_axes_labels(ax_g)\n    ax_g.set_title(\"global scene (true scale)\")\n    ax_g.legend(loc=\"upper left\", fontsize=7)\n\n    # ---------------- panel 2: target close-up ------------------------------\n    ax_3d = fig.add_subplot(1, 3, 2, projection=\"3d\")\n    for m in range(M):\n        c = centers[:, m]\n        ax_3d.plot(c[:, 0], c[:, 1], c[:, 2], color=colors[m], alpha=0.45, lw=1.0,\n                   label=f\"A{m}\")\n    for i, k in enumerate(frame_idx):\n        a = 1.0 - 0.75 * (i / max(len(frame_idx) - 1, 1))\n        for m in range(M):\n            loop = np.vstack([corners[k, m], corners[k, m, 0]])\n            ax_3d.plot(loop[:, 0], loop[:, 1], loop[:, 2], \"-\", color=colors[m],\n                       alpha=a, lw=1.6)\n    ax_3d.scatter(*centers[0].mean(axis=0), c=\"k\", marker=\"x\", s=40, alpha=0.7)\n    set_equal_3d(ax_3d, corners, pad=0.15)\n    _draw_axes_labels(ax_3d)\n    ax_3d.set_title(\"target close-up (equal aspect)\")\n    ax_3d.legend(loc=\"upper left\", fontsize=7)\n\n    # ---------------- panel 3: camera view ----------------------------------\n    alpha_of = {k: 1.0 - 0.72 * (i / max(len(frame_idx) - 1, 1))\n                for i, k in enumerate(frame_idx)}\n\n    def draw_view(ax, zoom):\n        for k in frame_idx:\n            for m in range(M):\n                res = project_polygon(corners[k, m], cam_pos, R_wc, cam)\n                if res is None:\n                    continue\n                u, v, _ = res\n                loop_u, loop_v = np.append(u, u[0]), np.append(v, v[0])\n                if cos[k, m] > 0.15:                 # front face: solid + fill\n                    ax.fill(loop_u, loop_v, color=colors[m], alpha=0.20 * alpha_of[k])\n                    ax.plot(loop_u, loop_v, \"-\", color=colors[m], lw=1.2,\n                            alpha=alpha_of[k])\n                    if zoom and k == frame_idx[-1]:\n                        ax.annotate(f\"A{m}\", (u.mean(), v.mean()),\n                                    textcoords=\"offset points\", xytext=(5, 4),\n                                    fontsize=8, color=colors[m])\n                elif cos[k, m] < -0.15:              # back face: dotted\n                    ax.plot(loop_u, loop_v, \":\", color=colors[m], lw=0.9,\n                            alpha=0.45 * alpha_of[k])\n                else:                                # edge-on: dashed\n                    ax.plot(loop_u, loop_v, \"--\", color=colors[m], lw=1.0,\n                            alpha=0.85 * alpha_of[k])\n        ax.set_aspect(\"equal\")\n\n    draw_view(ax_img := fig.add_subplot(1, 3, 3), zoom=False)\n    ax_img.add_patch(Rectangle((0, 0), cam.width, cam.height, fill=False,\n                               ec=\"#444444\", lw=1.2))\n    ax_img.plot([cam.cx - 20, cam.cx + 20], [cam.cy, cam.cy], color=\"#888888\", lw=0.8)\n    ax_img.plot([cam.cx, cam.cx], [cam.cy - 20, cam.cy + 20], color=\"#888888\", lw=0.8)\n    ax_img.set_xlim(-60, cam.width + 60)\n    ax_img.set_ylim(cam.height + 60, -60)\n    ax_img.set_title(f\"camera view {cam.width}x{cam.height}  fx={cam.fx:.0f}\")\n    ax_img.grid(alpha=0.25)\n\n    # zoom inset on the projected target region\n    uu, vv = [], []\n    for k in frame_idx:\n        for m in range(M):\n            res = project_polygon(corners[k, m], cam_pos, R_wc, cam)\n            if res is not None:\n                uu.append(res[0])\n                vv.append(res[1])\n    if uu:\n        uu, vv = np.concatenate(uu), np.concatenate(vv)\n        pad = 14.0\n        x0, x1 = uu.min() - pad, uu.max() + pad\n        y0, y1 = vv.min() - pad, vv.max() + pad\n        half = 0.5 * max(x1 - x0, y1 - y0)\n        cx, cy = 0.5 * (x0 + x1), 0.5 * (y0 + y1)\n        ax_zoom = ax_img.inset_axes([0.03, 0.03, 0.36, 0.36])\n        draw_view(ax_zoom, zoom=True)\n        ax_zoom.set_xlim(cx - half, cx + half)\n        ax_zoom.set_ylim(cy + half, cy - half)\n        ax_zoom.set_title(\"zoom on target\", fontsize=8)\n        ax_zoom.tick_params(labelsize=6)\n        ax_zoom.grid(alpha=0.25)\n        ax_zoom.set_facecolor(\"#f6f6f6\")\n        ax_img.add_patch(Rectangle((x0, y0), x1 - x0, y1 - y0, fill=False,\n                                   ec=\"#444444\", lw=1.0, ls=\"--\"))\n\n    fig.suptitle(\n        f\"{note}   solid = front face,  dashed = edge-on,  dotted = back face\"\n        f\"   (near clip {NEAR:.2f} m)\",\n        fontsize=9,\n    )\n    fig.tight_layout(rect=(0, 0, 1, 0.95))\n    return fig\n\n\n", "is_error": false, "diff": ""}
