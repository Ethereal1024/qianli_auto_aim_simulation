25, azim=-60):  # orthographic projection to 2D\n    ...\n```\nActually simplest: keep Axes3D but... no, projection math: \n```python\ndef ortho(points, elev_deg=25.0, azim_deg=-60.0):\n    e, a = np.radians(elev_deg), np.radians(azim_deg)\n    right = np.array([-np.sin(a), np.cos(a), 0.0])\n    up = np.array([-np.sin(e) * np.cos(a), -np.sin(e) * np.sin(a), np.cos(e)])\n    depth = np.cross(right, up)\n    return points @ right, points @ up, points @ depth\n```\nThen draw lines in 2D axes with `set_aspect(\"equal\")` and fixed limits from the whole clip. This is the \"pure 2D\" version; combined with axis off it's the cheapest (maybe ~10-20 ms for 3 panels).\n\nI should also mention: the `update()` python/numpy work is negligible (<1 ms) — so \"计算延迟\" (computation) is basically zero; the 94 ms is all rendering. So further gains must come from rendering.\n\nAlso mention: measure properly with something like\n```python\nt0 = time.perf_counter(); fig.canvas.draw(); print(round((time.perf_counter()-t0)*1e3, 1), \"ms\")\n```\ninserted at the top of `update` (or a small script that calls `update(i)` then `fig.canvas.draw()`).\n\nI'll also note that reducing figure size/dpi doesn't help (measured: 92–98 ms at dpi 60/80/100), so the cost is per-artist/per-pane overhead, not pixels — which is why removing panes/ticks helps and shrinking pixels doesn't.\n\nFinally: offer to implement. Since I'm in chat mode, I need them to switch to work mode.\n\nProvide a table with expected numbers, clearly marked as estimates pending measurement.\n\nAlso mention `interval=1000/FPS` currently 16.7 ms — with a 94 ms draw, the timer can't fire faster than the draw, so no busy-spin, but you could set `interval=1000/15` to avoid asking for frames you can't render (negligible).\n\nAlso: another trick — draw the 3D panels only every N frames? Since the 3D panels move every frame, not useful.\n\nAnother trick: `ax.set_rasterized(True)`? Only for vector output (savefig), not on-screen Agg.\n\nAnoth