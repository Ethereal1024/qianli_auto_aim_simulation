{"type": "tool_result", "timestamp": 1792652586.0498, "id": "98e72bf191e3", "tool_call_id": "call_00_hAM4LrwP7rC4CHxEGwR55212", "content": "OK: command succeeded\nstdout:\nimport math\n\nimport matplotlib.pyplot as plt\nimport numpy as np\nimport torch\n\nfrom diff_env.target import TargetMotion\n\n\ndef project_world_to_image(\n    corners_world: np.ndarray,\n    cam_pos: np.ndarray,\n    cam_yaw: float,\n    fx: float = 800.0,\n    fy: float = 800.0,\n):\n    R_inv = np.array(\n        [\n            [math.cos(-cam_yaw), -math.sin(-cam_yaw), 0],\n            [math.sin(-cam_yaw), math.cos(-cam_yaw), 0],\n            [0, 0, 1],\n        ]\n    )\n\n    R_wc = np.array(\n        [\n            [0, -1, 0],\n            [0, 0, -1],\n            [1, 0, 0],\n        ]\n    ) @ R_inv\n    \n    rel = corners_world.reshape(-1, 3) - cam_pos\n    cam_pts = (R_wc @ rel.T).T.reshape(corners_world.shape)\n    z = cam_pts[..., 2]\n    valid = z > 1e-3\n    u = fx * cam_pts[..., 0] / np.where(valid, z, 1.0)\n    v = fy * cam_pts[..., 1] / np.where(valid, z, 1.0)\n    return u, v, valid\n\n\ndef main():\n    torch.manual_seed(42)\n    \n    tm = TargetMotion(armor_width=0.12, armor_height=0.06)\n    bsz, sln = 1, 40\n    t = torch.linspace(0, 2.0, sln).unsqueeze(0)\n    \n    p0 = torch.tensor([[3.0, 0.0, 0.5]])\n    yaw_rate = torch.tensor([math.pi / 2])\n    radius = torch.tensor([0.3])\n    armor_pitch = math.radians(15.0)\n    \n    out = tm(\n        t, \"complex\",\n        p0=p0, yaw_rate=yaw_rate, n_armors=4, radius=radius,\n        armor_pitch=armor_pitch,\n        armor_height_offsets=torch.tensor([\n            [0.05, -0.05, 0.05, -0.05]\n        ])\n    )\n    centers = out[\"centers\"].detach().numpy()\n    corners = out[\"corners\"].detach().numpy()\n    \n    cam_pos = np.array([0.0, 0.0, 0.5])\n    cam_yaw = 0.0\n    \n    fig = plt.figure(figsize=(14, 6))\n    \n    ax3d = fig.add_subplot(1, 2, 1, projection=\"3d\")\n    for m in range(centers.shape[2]):\n        xs = centers[0, :, m, 0]\n        ys = centers[0, :, m, 1]\n        zs = centers[0, :, m, 2]\n        ax3d.plot(xs, ys, zs, alpha=0.4)\n        \n    for m in range(corners.shape[2]):\n        c = corners[0, 0, m]\n        c = np.vstack([c, c[0]])\n        ax3d.plot(c[:, 0], c[:, 1], c[:, 2], \"o-\")\n        \n    ax3d.scatter(*cam_pos, c=\"red\", marker=\"^\", s=100, label=\"camera\")\n    ax3d.set_xlabel(\"X (forward)\"); ax3d.set_ylabel(\"Y (left)\"); ax3d.set_zlabel(\"Z (up)\")\n    ax3d.set_title(\"3D world scene\")\n    ax3d.legend()\n\n    # ---- 右：相机视角 ----\n    ax_img = fig.add_subplot(1, 2, 2)\n    for m in range(corners.shape[2]):\n        c = corners[0, 0, m]                    # [4, 3]\n        u, v, valid = project_world_to_image(c, cam_pos, cam_yaw)\n        if valid.all():\n            order = [0, 1, 2, 3, 0]\n            ax_img.plot(u[order], v[order], \"o-\")\n            ax_img.text(u.mean(), v.mean(), f\"A{m}\", fontsize=8)\n\n    ax_img.set_xlim(-800, 800)\n    ax_img.set_ylim(800, -800)                  # 图像 y 向下\n    ax_img.set_aspect(\"equal\")\n    ax_img.set_title(\"camera view (normalized to pixel scale)\")\n    ax_img.grid(True, alpha=0.3)\n\n    plt.tight_layout()\n    plt.savefig(\"scripts/target_vis.png\", dpi=120)\n    plt.show()\n    print(\"saved to scripts/target_vis.png\")\n\n\nif __name__ == \"__main__\":\n    main()\n\n    ", "is_error": false, "diff": ""}
