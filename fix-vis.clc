{"type": "tool_result", "timestamp": 1792653998.436136, "id": "9343f4fe03ec", "tool_call_id": "call_01_VCeVeht3HBLeZqCdiDcz1417", "content": "OK: command succeeded\nstdout:\n     1\t#!/usr/bin/env python3\n     2\t\"\"\"Visualize a diff_env target: 3D world scene + pinhole camera projection.\n     3\t\n     4\tFrames\n     5\t------\n     6\tworld : RoboMaster style, +X forward, +Y left, +Z up, metres.\n     7\tcamera: +Z optical axis (depth), +X right, +Y down; pixels after projection.\n     8\t\n     9\tUsage\n    10\t-----\n    11\t    python3 scripts/visualize_target.py                  # -> scripts/target_vis.png\n    12\t    python3 scripts/visualize_target.py --test           # headless self-check\n    13\t    python3 scripts/visualize_target.py --out a.png --frames 6 --yaw-rate 1.0\n    14\t\"\"\"\n    15\t\n    16\tfrom __future__ import annotations\n    17\t\n    18\timport argparse\n    19\timport math\n    20\tfrom dataclasses import dataclass\n    21\t\n    22\timport matplotlib\n    23\timport matplotlib.colors as mcolors\n    24\t\n    25\tmatplotlib.use(\"Agg\")\n    26\t\n    27\timport matplotlib.pyplot as plt\n    28\timport numpy as np\n    29\timport torch\n    30\tfrom matplotlib.backends.backend_agg import FigureCanvasAgg\n    31\tfrom matplotlib.patches import Rectangle\n    32\t\n    33\tfrom diff_env.target import TargetMotion\n    34\t\n    35\tNEAR = 0.05          # near clip plane, metres\n    36\tBASE_COLORS = (\"#d62728\", \"#1f77b4\", \"#2ca02c\", \"#9467bd\", \"#ff7f0e\", \"#8c564b\")\n    37\t\n    38\t\n    39\t# --------------------------------------------------------------------------- #\n    40\t# camera model\n    41\t# --------------------------------------------------------------------------- #\n    42\t@dataclass(frozen=True)\n    43\tclass Pinhole:\n    44\t    fx: float = 800.0\n    45\t    fy: float = 800.0\n    46\t    width: int = 1280\n    47\t    height: int = 1024\n    48\t\n    49\t    @property\n    50\t    def cx(self) -> float:\n    51\t        return 0.5 * self.width\n    52\t\n    53\t    @property\n    54\t    def cy(self) -> float:\n    55\t        return 0.5 * self.height\n    56\t\n    57\t    def project(self, pts_cam: np.ndarray):\n    58\t        \"\"\"camera-space [..., 3] -> (u, v, depth); u right, v down, pixels.\"\"\"\n    59\t        z = pts_cam[..., 2]\n    60\t        z_safe = np.where(z >= NEAR, z, NEAR)\n    61\t        u = self.fx * pts_cam[..., 0] / z_safe + self.cx\n    62\t        v = self.cy + self.fy * pts_cam[..., 1] / z_safe     # +Y is down\n    63\t        return u, v, z\n    64\t\n    65\t\n    66\tdef camera_from_world(cam_yaw: float, cam_pitch: float = 0.0) -> np.ndarray:\n    67\t    \"\"\"Rotation R_wc with cam = R_wc @ (p_world - cam_pos).\n    68\t\n    69\t    cam_yaw rotates about world +Z (positive \n... [20661 chars omitted] ...\ndd_argument(\"--image-size\", type=int, nargs=2, default=[1280, 1024],\n   479\t                   metavar=(\"W\", \"H\"))\n   480\t    p.add_argument(\"--seed\", type=int, default=42)\n   481\t    p.add_argument(\"--test\", action=\"store_true\", help=\"headless self-check only\")\n   482\t    p.add_argument(\"--show\", action=\"store_true\", help=\"open an interactive window\")\n   483\t    return p\n   484\t\n   485\t\n   486\tdef main(argv=None) -> int:\n   487\t    args = build_parser().parse_args(argv)\n   488\t\n   489\t    cam = Pinhole(args.fx, args.fy, args.image_size[0], args.image_size[1])\n   490\t    cam_pos = np.array([0.0, 0.0, args.height])\n   491\t    cam_yaw = math.radians(args.cam_yaw_deg)\n   492\t    cam_pitch = math.radians(args.cam_pitch_deg)\n   493\t\n   494\t    scene = make_scene(args)\n   495\t    T, M = scene[\"corners\"].shape[:2]\n   496\t    print(\"target:\", M, \"armors x\", T, \"steps, body at\", scene[\"body\"])\n   497\t    print(f\"camera: {cam.width}x{cam.height} fx={cam.fx} fy={cam.fy} \"\n   498\t          f\"pos={cam_pos} yaw={args.cam_yaw_deg} deg\")\n   499\t\n   500\t    nz = float(np.abs(face_normals(scene[\"corners\"])[0, :, 2]).mean())\n   501\t    elev = math.degrees(math.asin(min(1.0, nz)))     # normal above the horizon\n   502\t    print(f\"plate normal elevation .. {elev:.1f} deg above horizon \"\n   503\t          f\"(orientation={args.plate_orientation})\")\n   504\t    if elev > 60.0:\n   505\t        print(\"  warning: plates lie nearly flat; a camera at plate height sees\")\n   506\t        print(\"           them edge-on, so the camera view collapses to slivers\")\n   507\t\n   508\t    if args.test:\n   509\t        run_self_test(scene, cam, cam_pos, args)\n   510\t        print(\"SELF-TEST PASSED\")\n   511\t        return 0\n   512\t\n   513\t    note = (f\"yaw_rate {math.degrees(args.yaw_rate):.0f} deg/s, \"\n   514\t            f\"distance {args.distance:.2f} m, \"\n   515\t            f\"armor pitch {args.armor_pitch_deg:.0f} deg, \"\n   516\t            f\"plates {args.plate_orientation}\")\n   517\t    fig = build_figure(scene, cam, cam_pos, cam_yaw, cam_pitch, args.frames, note)\n   518\t    fig.savefig(args.out, dpi=args.dpi)\n   519\t    plt.close(fig)\n   520\t    print(f\"saved -> {args.out}\")\n   521\t    if args.show:\n   522\t        if matplotlib.get_backend().lower() == \"agg\":\n   523\t            print(\"note: Agg backend is non-interactive, --show is a no-op here\")\n   524\t        else:\n   525\t            plt.show()\n   526\t    return 0\n   527\t\n   528\t\n   529\tif __name__ == \"__main__\":\n   530\t    raise SystemExit(main())\n", "is_error": false, "diff": ""}
