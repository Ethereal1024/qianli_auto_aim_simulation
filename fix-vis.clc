{"type": "tool_result", "timestamp": 1793177025.2171109, "id": "e64f760cdd8d", "tool_call_id": "call_00_rGyCLMwjiRPoKeKViAl21608", "content": "import sys, time\nimport matplotlib\nmatplotlib.use(\"Agg\")\nimport numpy as np\nimport matplotlib.pyplot as plt\nimport matplotlib.animation as manim\n\nsys.path.insert(0, \".\")\nimport scripts.visualize_target as vis\n\nCAP = {}\n\nclass Cap(manim.FuncAnimation):\n    def __init__(self, *a, **k):\n        super().__init__(*a, **k)\n        CAP[\"ani\"] = self\n\nmanim.FuncAnimation = Cap\n\n\ndef closures(f):\n    got = {}\n    for cell in (f.__closure__ or ()):\n        try:\n            v = cell.cell_contents\n        except ValueError:\n            continue\n        if isinstance(v, dict) and \"t0\" in v:\n            got[\"clock\"] = v\n        if hasattr(v, \"duration\") and hasattr(v, \"fps\"):\n            got[\"args\"] = v\n    return got\n\n\ndef fake_show(*a, **k):\n    ani = CAP[\"ani\"]\n    fig = plt.gcf()\n    ax, ax2, ax_img = fig.axes\n    got = closures(ani._func)\n    args, clock = got[\"args\"], got[\"clock\"]\n    n_frames = max(2, int(round(args.duration * args.fps)))\n\n    counts, lims, sizes = set(), set(), []\n    steps = list(range(0, n_frames, max(1, n_frames // 12))) + [n_frames - 1]\n    for k in steps:\n        clock[\"i\"] = -1\n        clock[\"t0\"] = time.perf_counter() - k * args.duration / (n_frames - 1)\n        ani._func(0)\n        counts.add((len(ax.lines), len(ax2.lines), len(ax_img.lines),\n                    len(ax_img.patches)))\n        lims.add(tuple(np.round(np.concatenate([\n            ax.get_xlim(), ax.get_ylim(), ax.get_zlim(),\n            ax2.get_xlim(), ax2.get_ylim(), ax2.get_zlim(),\n            ax_img.get_xlim(), ax_img.get_ylim()]), 9)))\n        sizes.append(round(float(np.ptp(ax_img.lines[0].get_xdata())), 1))\n\n    print(\"  frames stepped:\", len(steps), \"of\", n_frames)\n    print(\"  artist counts stable:\", len(counts) == 1, sorted(counts))\n    print(\"  limits stable:\", len(lims) == 1)\n    print(\"  plate px width over time:\", sizes[:6], \"...\", sizes[-3:])\n    print(\"  axis line len:\", len(ax.lines[0].get_data_3d()[0]),\n          \"visible fills:\", sum(p.get_visible() for p in ax_img.patches))\n    print(\"  title:\", ax_img.get_title())\n    fig.canvas.draw()\n    fig.savefig(\"/tmp/vis_check.png\", dpi=80)\n    print(\"  saved /tmp/vis_check.png\")\n\n\nplt.show = fake_show\n\nprint(\"run 1: distance 3\")\nvis.main([\"--distance\", \"3\", \"--duration\", \"2\", \"--fps\", \"50\"])\nplt.close(\"all\")\n\nprint(\"run 2: distance 5\")\nvis.main([\"--distance\", \"5\", \"--duration\", \"2\", \"--fps\", \"50\"])\nplt.close(\"all\")\n\nprint(\"run 3: cam yaw 20, yaw 45\")\nvis.main([\"--distance\", \"3\", \"--cam-yaw\", \"20\", \"--yaw\", \"45\",\n          \"--duration\", \"2\", \"--fps\", \"50\"])\nplt.close(\"all\")\n", "is_error": false, "diff": ""}
