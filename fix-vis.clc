{"type": "tool_result", "timestamp": 1792652632.1344588, "id": "e0a0f3cd8f6e", "tool_call_id": "call_00_88XHaJgTJiZj48NCePXU0503", "content": "OK: command succeeded\nstdout:\n1:import math\n2:\n3:import matplotlib.pyplot as plt\n4:import numpy as np\n5:import torch\n6:\n7:from diff_env.target import TargetMotion\n8:\n9:\n10:def project_world_to_image(\n11:    corners_world: np.ndarray,\n12:    cam_pos: np.ndarray,\n13:    cam_yaw: float,\n14:    fx: float = 800.0,\n15:    fy: float = 800.0,\n16:):\n17:    R_inv = np.array(\n18:        [\n19:            [math.cos(-cam_yaw), -math.sin(-cam_yaw), 0],\n20:            [math.sin(-cam_yaw), math.cos(-cam_yaw), 0],\n60:        ])\n61:    )\n62:    centers = out[\"centers\"].detach().numpy()\n63:    corners = out[\"corners\"].detach().numpy()\n64:    \n65:    cam_pos = np.array([0.0, 0.0, 0.5])\n66:    cam_yaw = 0.0\n67:    \n68:    fig = plt.figure(figsize=(14, 6))\n69:    \n70:    ax3d = fig.add_subplot(1, 2, 1, projection=\"3d\")\n71:    for m in range(centers.shape[2]):\n72:        xs = centers[0, :, m, 0]\n73:        ys = centers[0, :, m, 1]\n74:        zs = centers[0, :, m, 2]\n75:        ax3d.plot(xs, ys, zs, alpha=0.4)\n76:        \n77:    for m in range(corners.shape[2]):\n78:        c = corners[0, 0, m]\n79:        c = np.vstack([c, c[0]])\n80:        ax3d.plot(c[:, 0], c[:, 1], c[:, 2], \"o-\")\n81:        \n82:    ax3d.scatter(*cam_pos, c=\"red\", marker=\"^\", s=100, label=\"camera\")\n83:    ax3d.set_xlabel(\"X (forward)\"); ax3d.set_ylabel(\"Y (left)\"); ax3d.set_zlabel(\"Z (up)\")\n84:    ax3d.set_title(\"3D world scene\")\n85:    ax3d.legend()\n86:\n87:    # ---- 右：相机视角 ----\n88:    ax_img = fig.add_subplot(1, 2, 2)\n89:    for m in range(corners.shape[2]):\n90:        c = corners[0, 0, m]                    # [4, 3]\n91:        u, v, valid = project_world_to_image(c, cam_pos, cam_yaw)\n92:        if valid.all():\n93:            order = [0, 1, 2, 3, 0]\n94:            ax_img.plot(u[order], v[order], \"o-\")\n95:            ax_img.text(u.mean(), v.mean(), f\"A{m}\", fontsize=8)\n96:\n97:    ax_img.set_xlim(-800, 800)\n98:    ax_img.set_ylim(800, -800)                  # 图像 y 向下\n99:    ax_img.set_aspect(\"equal\")\n100:    ax_img.set_title(\"camera view (normalized to pixel scale)\")\n101:    ax_img.grid(True, alpha=0.3)\n102:\n103:    plt.tight_layout()\n104:    plt.savefig(\"scripts/target_vis.png\", dpi=120)\n105:    plt.show()\n106:    print(\"saved to scripts/target_vis.png\")\n107:\n108:\n109:if __name__ == \"__main__\":\n110:    main()\n111:\n112:    \n", "is_error": false, "diff": ""}
