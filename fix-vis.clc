derer)))\\nprint(\\\"  ax_image.draw        %6.1f ms\\\" % med(lambda: axi.draw(renderer)))\\nprint(\\\"  artists only (%d)     %6.1f ms\\\" % (len(moving), med(\\n    lambda: [a.axes.draw_artist(a) for a in moving], 3)))\\n\\n# what a blit=True frame costs: restore the cached background, repaint the\\n# artists that move, push the buffer to the screen\\nfig.canvas.draw()\\nbg = fig.canvas.copy_from_bbox(fig.bbox)\\nstate = {\\\"i\\\": 0}\\n\\n\\ndef blit_frame():\\n    state[\\\"i\\\"] = (state[\\\"i\\\"] + 1) % n\\n    update(state[\\\"i\\\"])\\n    fig.canvas.restore_region(bg)\\n    for a in moving:\\n        a.axes.draw_artist(a)\\n    fig.canvas.blit(fig.bbox)\\n\\n\\nprint(\\\"blit frame             %6.1f ms\\\" % med(blit_frame))\\n\\n# variants that need no blit machinery\\nfor ax in (axw, axa):\\n    ax.grid(False)\\nprint(\\\"grid off, full draw    %6.1f ms\\\" % med(fig.canvas.draw))\\nfor ax in (axw, axa):\\n    for axis in (ax.xaxis, ax.yaxis, ax.zaxis):\\n        axis.pane.set_visible(False)\\nprint(\\\"panes hidden, full     %6.1f ms\\\" % med(fig.canvas.draw))\\nfor ax in (axw, axa):\\n    ax.set_axis_off()\\nprint(\\\"axis off, full draw    %6.1f ms\\\" % med(fig.canvas.draw))\\nprint(\\\"  ax_world.draw        %6.1f ms\\\" % med(lambda: axw.draw(renderer)))\\nprint(\\\"  ax_armor.draw        %6.1f ms\\\" % med(lambda: axa.draw(renderer)))\\nprint(\\\"axis off + blit frame  %6.1f ms\\\" % med(blit_frame))\\n\", \"path\": \"/tmp/prof.py\"}"}], "reasoning": "`Text3D.draw` (line 217) also projects itself and needs only `self.axes` (for `_scale_proj_transform(..., self.axes)` which reads `axes.M`, `axes.transData`/bbox). So blitting works for both Line3D and Text3D as long as `axes.M` and the axes geometry are unchanged — exactly our case (fixed view/limits, no panes changes).\n\nGood. Now measure baseline and blit before editing. Write /tmp/prof.py.\n\nNote baseline module currently has no `moving`; the profiler should compute the artist list itself (