enderer)))\\nprint(\\\"  artists only (%d)     %6.1f ms\\\" % (len(moving), med(\\n    lambda: [a.axes.draw_artist(a) for a in moving], 3)))\\n\\n# what a blit=True frame costs: restore the cached background, repaint the\\n# artists that move, push the buffer to the screen\\nfig.canvas.draw()\\nbg = fig.canvas.copy_from_bbox(fig.bbox)\\nstate = {\\\"i\\\": 0}\\n\\n\\ndef blit_frame():\\n    state[\\\"i\\\"] = (state[\\\"i\\\"] + 1) % n\\n    update(state[\\\"i\\\"])\\n    fig.canvas.restore_region(bg)\\n    for a in moving:\\n        a.axes.draw_artist(a)\\n    fig.canvas.blit(fig.bbox)\\n\\n\\nprint(\\\"blit frame             %6.1f ms\\\" % med(blit_frame))\\n\\n# variants that need no blit machinery\\nfor ax in (axw, axa):\\n    ax.grid(False)\\nprint(\\\"grid off, full draw    %6.1f ms\\\" % med(fig.canvas.draw))\\nfor ax in (axw, axa):\\n    for axis in (ax.xaxis, ax.yaxis, ax.zaxis):\\n        axis.pane.set_visible(False)\\nprint(\\\"panes hidden, full     %6.1f ms\\\" % med(fig.canvas.draw))\\nfor ax in (axw, axa):\\n    ax.set_axis_off()\\nprint(\\\"axis off, full draw    %6.1f ms\\\" % med(fig.canvas.draw))\\nprint(\\\"  ax_world.draw        %6.1f ms\\\" % med(lambda: axw.draw(renderer)))\\nprint(\\\"  ax_armor.draw        %6.1f ms\\\" % med(lambda: axa.draw(renderer)))\\nprint(\\\"axis off + blit frame  %6.1f ms\\\" % med(blit_frame))\\n\", \"path\": \"/tmp/prof.py\"}", "tool_call_id": "call_00_J4UzJ0U6U41iJ9h9FAmm1465", "ui": {"group": null, "chip": "name", "summary": "", "preview": {"keys": ["✎path", "content"], "mode": "content"}, "header": "✓ wrote {path}", "form": "block", "body": "diff", "collapse": "long", "highlight": "", "chrome": "accent", "mutates": true, "undo": true}, "path_arg": "path"}
{"type": "tool_result", "timestamp": 1793178015.8001902, "id": "6d19ec32d192", "tool_call_id": "call_00_J4UzJ0U6U41iJ9h9FAmm1465", "content": "OK: wrote /tmp/prof.py (2825 chars)", "is_error": false, "diff": "--- a//tmp/prof.py\n+++ b//tmp/prof.py\n@@ -0,0 +1,90 @@\n+import os, sys, time, runpy\n+import matplotlib\n+matplotlib.use(\"Agg\")\n+import numpy as np\n+import matplotlib.pyplot as plt\n+import matplotlib.animation as manim\n+\n+sys.path.insert(0, os.getcwd())\n+CAP = {}\n+\n+\n+class Cap(manim.FuncAnimation):\n+    def __init__(self, *a, **k):\n+        super().__init__(*a, **k)\n+        CAP[\"ani\"] = self\n+        CAP[\"blit\"] = k.get(\"blit\", False)\n+\n+\n+manim.FuncAnimation = Cap\n+plt.show = lambda *a, **k: None\n+\n+g = runpy.run_path(\"scripts/visualize_target.py\", run_name=\"__main__\")\n+fig, update, n = g[\"fig\"], g[\"update\"], g[\"N_FRAMES\"]\n+axw, axa, axi = g[\"ax_world\"], g[\"ax_armor\"], g[\"ax_image\"]\n+renderer = fig.canvas.get_renderer()\n+\n+\n+def med(fn, k=7):\n+    ts = []\n+    for _ in range(k):\n+        t0 = time.perf_counter()\n+        fn()\n+        ts.append(time.perf_counter() - t0)\n+    ts.sort()\n+    return ts[len(ts) // 2] * 1e3\n+\n+\n+def updates(k=60):\n+    for i in range(k):\n+        update(i)\n+\n+\n+moving = g.get(\"moving\")\n+if moving is None:\n+    moving = ([a for lines, text, _ in g[\"world_frames\"] + g[\"armor_frames\"]\n+               for a in (*lines, text)]\n+              + g[\"world_plates\"] + g[\"armor_plates\"]\n+              + g[\"fills\"] + g[\"edges\"] + g[\"tags\"])\n+\n+print(\"=== per frame (median of 7) ===  blit flag in module:\", CAP.get(\"blit\"))\n+print(\"update() data only     %6.2f ms\" % (med(updates, 3) / 60))\n+print(\"full canvas.draw       %6.1f ms\" % med(fig.canvas.draw))\n+print(\"  ax_world.draw        %6.1f ms\" % med(lambda: axw.draw(renderer)))\n+print(\"  ax_armor.draw        %6.1f ms\" % med(lambda: axa.draw(renderer)))\n+print(\"  ax_image.draw        %6.1f ms\" % med(lambda: axi.draw(renderer)))\n+print(\"  artists only (%d)     %6.1f ms\" % (len(moving), med(\n+    lambda: [a.axes.draw_artist(a) for a in moving], 3)))\n+\n+# what a blit=True frame costs: restore the cached background, repaint the\n+# artists that move, push the buffer to the screen\n+fig.canvas.draw()\n+bg = fig.canvas.copy_from_bbox(fig.bbox)\n+state = {\"i\": 0}\n+\n+\n+def blit_frame():\n+    state[\"i\"] = (state[\"i\"] + 1) % n\n+    update(state[\"i\"])\n+    fig.canvas.restore_region(bg)\n+    for a in moving:\n+        a.axes.draw_artist(a)\n+    fig.canvas.blit(fig.bbox)\n+\n+\n+print(\"blit frame             %6.1f ms\" % med(blit_frame))\n+\n+# variants that need no blit machinery\n+for ax in (axw, axa):\n+    ax.grid(False)\n+print(\"grid off, full draw    %6.1f ms\" % med(fig.canvas.draw))\n+for ax in (axw, axa):\n+    for axis in (ax.xaxis, ax.yaxis, ax.zaxis):\n+        axis.pane.set_visible(False)\n+print(\"panes hidden, full     %6.1f ms\" % med(fig.canvas.draw))\n+for ax in (axw, axa):\n+    ax.set_axis_off()\n+print(\"axis off, full draw    %6.1f ms\" % med(fig.canvas.draw))\n+print(\"  ax_world.draw        %6.1f ms\" % med(lambda: axw.draw(renderer)))\n+print(\"  ax_armor.draw        %6.1f ms\" % med(lambda: axa.draw(renderer)))\n+print(\"axis off + blit frame  %6.1f ms\" % med(blit_frame))\n"}
