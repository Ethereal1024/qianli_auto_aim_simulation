{"type": "tool_result", "timestamp": 1793177058.1455486, "id": "d8e84c853837", "tool_call_id": "call_00_ElshwVnqFrCju5OnKUgU9503", "content": "OK: wrote /tmp/check_consts.py (1394 chars)", "is_error": false, "diff": "--- a//tmp/check_consts.py\n+++ b//tmp/check_consts.py\n@@ -0,0 +1,40 @@\n+import os, sys\n+import matplotlib\n+matplotlib.use(\"Agg\")\n+import numpy as np\n+import matplotlib.pyplot as plt\n+import matplotlib.animation as manim\n+\n+sys.path.insert(0, os.getcwd())\n+manim.FuncAnimation = type(\"Cap\", (manim.FuncAnimation,), {})\n+plt.show = lambda *a, **k: None\n+\n+src = open(\"scripts/visualize_target.py\").read()\n+\n+\n+def run(dist, cam_yaw, yaw):\n+    code = src.replace(\"DISTANCE = 3.0\", \"DISTANCE = %r\" % dist)\n+    code = code.replace(\"CAM_YAW = 0.0\", \"CAM_YAW = %r\" % cam_yaw)\n+    code = code.replace(\"YAW = 0.0\", \"YAW = %r\" % yaw)\n+    g = {\"__name__\": \"__main__\"}\n+    exec(compile(code, \"vis\", \"exec\"), g)\n+    fig, update, n = g[\"fig\"], g[\"update\"], g[\"N_FRAMES\"]\n+    ax_img = g[\"ax_image\"]\n+    widths = []\n+    for k in (0, n // 4, n // 2, 3 * n // 4, n - 1):\n+        update(k)\n+        widths.append(round(float(np.ptp(ax_img.lines[0].get_xdata())), 1))\n+    x0, x1 = ax_img.get_xlim()\n+    y0, y1 = ax_img.get_ylim()\n+    print(\"d=%s cam_yaw=%s yaw=%s\" % (dist, cam_yaw, yaw))\n+    print(\"  px/m title:\", ax_img.get_title().split(\",\")[-1].strip())\n+    print(\"  window:\", [round(v, 2) for v in (x0, x1, y0, y1)],\n+          \"| centre:\", round((x0 + x1) / 2, 2), round((y0 + y1) / 2, 2))\n+    print(\"  plate px width at 5 sampled frames:\", widths)\n+    fig.savefig(\"/tmp/vis_%s_%s.png\" % (dist, cam_yaw), dpi=60)\n+    plt.close(\"all\")\n+\n+\n+run(3.0, 0.0, 0.0)\n+run(6.0, 0.0, 0.0)\n+run(3.0, 30.0, 45.0)\n"}
