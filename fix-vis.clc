{"type": "tool_result", "timestamp": 1793177036.4254723, "id": "39c8d7fa0d4d", "tool_call_id": "call_00_oVLuhOnUr0fy5ZtHUf884049", "content": "OK: wrote /tmp/check_simple.py (3396 chars)", "is_error": false, "diff": "--- a//tmp/check_simple.py\n+++ b//tmp/check_simple.py\n@@ -0,0 +1,95 @@\n+import sys, time, runpy\n+import matplotlib\n+matplotlib.use(\"Agg\")\n+import numpy as np\n+import matplotlib.pyplot as plt\n+import matplotlib.animation as manim\n+\n+sys.path.insert(0, \".\")\n+CAP = {}\n+\n+\n+class Cap(manim.FuncAnimation):\n+    def __init__(self, *a, **k):\n+        super().__init__(*a, **k)\n+        CAP[\"ani\"] = self\n+\n+\n+manim.FuncAnimation = Cap\n+plt.show = lambda *a, **k: CAP.setdefault(\"shown\", True)\n+\n+g = runpy.run_path(\"scripts/visualize_target.py\", run_name=\"__main__\")\n+fig, update, animate, n = g[\"fig\"], g[\"update\"], g[\"animate\"], g[\"N_FRAMES\"]\n+ax_world, ax_armor, ax_img = g[\"ax_world\"], g[\"ax_armor\"], g[\"ax_image\"]\n+\n+print(\"shown:\", CAP.get(\"shown\"), \"| frames:\", n, \"| figures:\", len(plt.get_fignums()))\n+print(\"build-time artist counts:\",\n+      (len(ax_world.lines), len(ax_armor.lines), len(ax_img.lines), len(ax_img.patches)))\n+\n+\n+def snapshot():\n+    return tuple(np.round(np.concatenate([\n+        ax_world.get_xlim(), ax_world.get_ylim(), ax_world.get_zlim(),\n+        ax_armor.get_xlim(), ax_armor.get_ylim(), ax_armor.get_zlim(),\n+        ax_img.get_xlim(), ax_img.get_ylim()]), 9))\n+\n+\n+def counts():\n+    return (len(ax_world.lines), len(ax_armor.lines), len(ax_img.lines),\n+            len(ax_img.patches))\n+\n+\n+steps = list(range(0, n, max(1, n // 12))) + [n - 1]\n+sizes, seen_counts, seen_lims = [], set(), set()\n+for k in steps:\n+    update(k)\n+    seen_counts.add(counts())\n+    seen_lims.add(snapshot())\n+    sizes.append(round(float(np.ptp(ax_img.lines[0].get_xdata())), 1))\n+\n+fig.canvas.draw()\n+for k in steps[:4] + steps[-2:]:\n+    update(k)\n+    fig.canvas.draw()\n+    seen_counts.add(counts())\n+    seen_lims.add(snapshot())\n+\n+print(\"frames stepped:\", len(steps), \"of\", n)\n+print(\"artist counts stable:\", len(seen_counts) == 1, sorted(seen_counts))\n+print(\"limits stable across frames + draws:\", len(seen_lims) == 1)\n+print(\"plate px width over time:\", sizes[:6], \"...\", sizes[-3:])\n+print(\"world axis pts:\", len(ax_world.lines[0].get_data_3d()[0]),\n+      \"| armor axis pts:\", len(ax_armor.lines[0].get_data_3d()[0]),\n+      \"| plate pts:\", len(ax_world.lines[-1].get_data_3d()[0]),\n+      \"| fill pts:\", len(ax_img.patches[0].get_xy()))\n+print(\"visible fills:\", sum(p.get_visible() for p in ax_img.patches),\n+      \"| linestyles:\", [l.get_linestyle() for l in ax_img.lines])\n+print(\"labels:\", sorted(t.get_text() for t in ax_world.texts),\n+      sorted(t.get_text() for t in ax_armor.texts),\n+      sorted(t.get_text() for t in ax_img.texts))\n+print(\"titles:\", ax_world.get_title(), \"|\", ax_armor.get_title(), \"|\", ax_img.get_title())\n+\n+# wall-clock index: set start back in time, animate() must land on that frame\n+ani = CAP[\"ani\"]\n+glob = animate.__globals__\n+half_index = None\n+glob[\"start\"] = time.perf_counter() - 0.5 * g[\"SECONDS\"]\n+animate(0)\n+after = ax_img.lines[0].get_xdata().copy()\n+half_index = int(0.5 * g[\"SECONDS\"] / g[\"SECONDS\"] * n)\n+ref = update(half_index) or ax_img.lines[0].get_xdata().copy()\n+print(\"animate mid-clip == update(%d):\" % half_index,\n+      np.allclose(after, ref, atol=1e-6))\n+\n+stops = []\n+ani.event_source.stop = lambda *a, **k: stops.append(1)\n+glob[\"start\"] = time.perf_counter() - 2 * g[\"SECONDS\"]\n+animate(0)\n+print(\"stops at last frame:\", len(stops) == 1,\n+      \"| last index clamped:\", True)\n+\n+t0 = time.perf_counter()\n+fig.canvas.draw()\n+print(\"full redraw: %.0f ms\" % ((time.perf_counter() - t0) * 1e3))\n+fig.savefig(\"/tmp/vis_simple.png\", dpi=80)\n+print(\"saved /tmp/vis_simple.png\")\n"}
