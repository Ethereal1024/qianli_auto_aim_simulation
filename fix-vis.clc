qual-aspect cube around points -> (xmin, xmax, ymin, ymax, zmin, zmax).\\\"\\\"\\\"\\n    pts = np.reshape(points, (-1, 3))\\n    lo, hi = pts.min(0), pts.max(0)\\n    mid, half = (lo + hi) / 2, (hi - lo).max() / 2 + pad\\n    return (mid[0] - half, mid[0] + half,\\n            mid[1] - half, mid[1] + half,\\n            mid[2] - half, mid[2] + half)\\n\\n\\ndef apply_cube(ax, lim):\\n    ax.set_xlim(lim[0], lim[1])\\n    ax.set_ylim(lim[2], lim[3])\\n    ax.set_zlim(lim[4], lim[5])\\n    ax.set_box_aspect((1.0, 1.0, 1.0))\\n\\n\\ndef label_axes(ax):\\n    ax.set_xlabel(\\\"X fwd (m)\\\")\\n    ax.set_ylabel(\\\"Y left (m)\\\")\\n    ax.set_zlabel(\\\"Z up (m)\\\")\\n\\n\\ndef new_frame(ax, lengths, labels):\\n    \\\"\\\"\\\"one empty [x, y, z] line triple plus an origin label per frame.\\\"\\\"\\\"\\n    lines = [[ax.plot([], [], [], color=c, lw=2)[0] for c in AXIS_COLORS]\\n             for _ in lengths]\\n    texts = [ax.text(0.0, 0.0, 0.0, s, fontsize=8) for s in labels]\\n    return lines, texts\\n\\n\\ndef build(ax, ax2, ax_img, fixed, n_armors):\\n    \\\"\\\"\\\"create every artist exactly once; only draw() touches them afterwards.\\\"\\\"\\\"\\n    art = {}\\n    art[\\\"frames\\\"], art[\\\"labels\\\"] = new_frame(ax, (0.5, 0.3, 0.25), (\\\"W\\\", \\\"C\\\", \\\"B\\\"))\\n    art[\\\"plates\\\"] = [ax.plot([], [], [], color=\\\"#666666\\\", lw=1.0)[0]\\n                     for _ in range(n_armors)]\\n\\n    art[\\\"frames2\\\"], art[\\\"labels2\\\"] = new_frame(\\n        ax2, (0.2,) + (0.1,) * n_armors,\\n        (\\\"B\\\",) + tuple(f\\\"A{m}\\\" for m in range(n_armors)))\\n    art[\\\"plates2\\\"] = [ax2.plot([], [], [], color=ARMOR_COLORS[m], lw=1.2)[0]\\n                      for m in range(n_armors)]\\n\\n    art[\\\"fills\\\"], art[\\\"edges\\\"], art[\\\"tags\\\"] = [], [], []\\n    for m in range(n_armors):\\n        fill = Polygon(np.zeros((4, 2)), closed=True, lw=0, zorder=1,\\n                       facecolor=ARMOR_COLORS[m], alpha=0.35)\\n        ax_img.add_patch(fill)\\n        art[\\\"fills\\\"].append(fill)\\n        art[\\\"edges\\\"].append(ax_img.plot([], [], color=ARMOR_COLORS[m], lw=1.2,\\n                                        zorder=2)[0])\\n        art[\\\"tags\\\"].append(ax_img.text(0.0, 0.0, f\\\"A{m}\\\", fontsize=8, zorder=3))\\n\\n    apply_cube(ax, fixed[\\\"ax\\\"])\\n    apply_cube(ax2, fixed[\\\"ax2\\\"])\\n    ax_img.set_xlim(fixed[\\\"img\\\"][0], fixed[\\\"img\\\"][1])\\n    ax_img.set_ylim(fixed[\\\"img\\\"][2], fixed[\\\"img\\\"][3])\\n    ax_img.set_aspect(\\\"equal\\\")\\n    ax_img.grid(alpha=0.3)\\n    for a in (ax, ax2, ax_img):\\n        a.set_autoscale_on(False)      # one scale for the whole clip\\n    return art\\n\\n\\ndef draw(index, out, args, art, n_armors):\\n    \\\"\\\"\\\"point every artist at frame *index*: nothing created, nothing cleared.\\\"\\\"\\\"\\n    centers = out[\\\"centers\\\"][0, index].numpy()\\n    corners = out[\\\"corners\\\"][0, index].numpy()          # (M, 4, 3)\\n    body_rot = out[\\\"body_rotations\\\"][0, index].numpy()\\n    armor_rot = out[\\\"armor_rotations\\\"][0, index].numpy()\\n\\n    cam_pos = np.array([0.0, 0.0, args.height])\\n    body = np.array([args.distance, 0.0, args.height])\\n    R_wc = camera_rotation(args.cam_yaw)\\n\\n    # panel 1: world, camera and body frames, true scale\\n    for k, (origin, rot, length) in enumerate((\\n            (np.zeros(3), np.eye(3), 0.5),\\n            (cam_pos, R_wc.T, 0.3),\\n            (body, body_rot, 0.25))):\\n        for j, line in enumerate(art[\\\"frames\\\"][k]):\\n            line.set_data_3d(*segment(origin, origin + length * rot[:, j]))\\n        art[\\\"labels\\\"][k].set_position_3d(origin)\\n    for m in range(n_armors):\\n        art[\\\"plates\\\"][m].set_data_3d(*np.vstack([corners[m], corners[m, 0]]).T)\\n\\n    # panel 2: body and armor frames, close up\\n    close = [(body, body_rot, 0.2)] + [(centers[m], armor_rot[m], 0.1)\\n                                       for m in range(n_armors)]\\n    for k, (origin, rot, length) in enumerate(close):\\n        for j, line in enumerate(art[\\\"frames2\\\"][k]):\\n            line.set_data_3d(*segment(origin, origin + length * rot[:, j]))\\n        art[\\\"labels2\\\"][k].set_position_3d(origin)\\n    for m in range(n_armors):\\n        art[\\\"plates2\\\"][m].set_data_3d(*np.vstack([corners[m], corners[m, 0]]).T)\\n\\n    # panel 3: camera view; solid = front face, dotted = back\\n    w, h = args.image_size\\n    u, v, _ = project(corners, R_wc, cam_pos, args.fx, args.fx, w / 2, h / 2)\\n    normal = np.cross(corners[:, 1] - corners[:, 0], corners[:, 3] - corners[:, 0])\\n    normal /= np.linalg.norm(normal, axis=-1, keepdims=True)\\n    front = (normal * (cam_pos - centers)).sum(-1) > 0\\n    for m in range(n_armors):\\n        loop = np.column_stack([np.append(u[m], u[m, 0]), np.append(v[m], v[m, 0])])\\n        art[\\\"fills\\\"][m].set_xy(loop)\\n        art[\\\"fills\\\"][m].set_visible(bool(front[m]))\\n        art[\\\"edges\\\"][m].set_data(loop[:, 0], loop[:, 1])\\n        art[\\\"edges\\\"][m].set_linestyle(\\\"-\\\" if front[m] else \\\":\\\")\\n        art[\\\"tags\\\"][m].set_position((u[m].mean(), v[m].mean()))\\n\\n\\ndef main(argv=None) -> int:\\n    p = argparse.ArgumentParser(description=__doc__)\\n    p.add_argument(\\\"--distance\\\", type=float, default=3.0, help=\\\"target distance (m)\\\")\\n    p.add_argument(\\\"--height\\\", type=float, default=0.5, help=\\\"target/camera height (m)\\\")\\n    p.add_argument(\\\"--radius\\\", type=float, default=0.3)\\n    p.add_argument(\\\"--yaw\\\", type=float, default=0.0, help=\\\"target yaw (deg)\\\")\\n    p.add_argument(\\\"--cam-yaw\\\", type=float, default=0.0,\\n                   help=\\\"camera yaw (deg), positive looks left\\\")\\n    p.add_argument(\\\"--fx\\\", type=float, default=800.0)\\n    p.add_argument(\\\"--image-size\\\", type=int, nargs=2, default=[1280, 1024],\\n                   metavar=(\\\"W\\\", \\\"H\\\"))\\n    p.add_argument(\\\"--dpi\\\", type=int, default=100)\\n    p.add_argument(\\\"--duration\\\", type=float, default=10.0)\\n    p.add_argument(\\\"--fps\\\", type=float, default=60.0)\\n    args = p.parse_args(argv)\\n    if args.duration <= 0 or args.fps <= 0:\\n        p.error(\\\"--duration and --fps must be positive\\\")\\n\\n    n_armors = 4\\n    n_frames = max(2, int(round(args.duration * args.fps)))\\n    t = torch.linspace(0.0, args.duration, n_frames).unsqueeze(0)\\n    clock = {\\\"t0\\\": None, \\\"i\\\": -1}\\n\\n    out = TargetMotion()(\\n        t,\\n        \\\"complex\\\",\\n        p0=torch.tensor([[args.distance, 0.0, args.height]]),\\n        yaw_0=torch.tensor([math.radians(args.yaw)]),\\n        yaw_rate=torch.tensor([3]),\\n        n_armors=n_armors,\\n        radius=torch.tensor([args.radius]),\\n    )\\n\\n    # one scale for the whole clip: limits from every frame of the trajectory\\n    w, h = args.image_size\\n    cam_pos = np.array([0.0, 0.0, args.height])\\n    body = np.array([args.distance, 0.0, args.height])\\n    R_wc = camera_rotation(args.cam_yaw)\\n    all_corners = out[\\\"corners\\\"][0].numpy()                 # (T, M, 4, 3)\\n    u_all, v_all, _ = project(all_corners, R_wc, cam_pos,\\n                              args.fx, args.fx, w / 2, h / 2)\\n    fixed = {\\n        \\\"ax\\\": cube_limits(np.vstack([all_corners.reshape(-1, 3), cam_pos, np.zeros(3)]), 0.1),\\n        \\\"ax2\\\": cube_limits(np.vstack([all_corners.reshape(-1, 3), body]), 0.15),\\n    }\\n    px_per_m = args.fx / args.distance        # fixed: no per-frame autozoom\\n    half = (args.radius + 0.25) * px_per_m\\n    cu, cv = u_all.mean(), v_all.mean()\\n    fixed[\\\"img\\\"] = (cu - half, cu + half, cv + half, cv - half)   # v grows downwards\\n\\n    fig = plt.figure(figsize=(16.5, 5.2), dpi=args.dpi)\\n    ax = fig.add_subplot(1, 3, 1, projection=\\\"3d\\\")\\n    ax2 = fig.add_subplot(1, 3, 2, projection=\\\"3d\\\")\\n    ax_img = fig.add_subplot(1, 3, 3)\\n    fig.subplots_adjust(left=0.04, right=0.98, bottom=0.10, top=0.85, wspace=0.15)\\n    for a in (ax, ax2):\\n        label_axes(a)\\n    ax.set_title(\\\"world, camera and body frames\\\")\\n    ax2.set_title(\\\"armor frames\\\")\\n    ax_img.set_title(f\\\"camera view at {args.distance:.1f} m \\\"\\n                     f\\\"({w}x{h}, fx={args.fx:.0f}, {px_per_m:.0f} px/m)\\\")\\n    fig.suptitle(\\\"W world, C camera, B body, A# armor;  x red, y green, z blue\\\",\\n                 fontsize=9)\\n\\n    art = build(ax, ax2, ax_img, fixed, n_armors)\\n    draw(0, out, args, art, n_armors)\\n\\n    from matplotlib.animation import FuncAnimation\\n\\n    def on_frame(_frame):\\n        if clock[\\\"t0\\\"] is None:            # start the clock on the first frame\\n            clock[\\\"t0\\\"] = time.perf_counter()\\n        i = int((time.perf_counter() - clock[\\\"t0\\\"]) / args.duration * n_frames)\\n        i = min(i, n_frames - 1)           # clamp: stop on the last frame\\n        if i == clock[\\\"i\\\"]:                # wall clock has not moved a frame yet\\n            return\\n        clock[\\\"i\\\"] = i\\n        draw(i, out, args, art, n_armors)\\n        if i == n_frames - 1 and ani.event_source is not None:\\n            ani.event_source.stop()\\n\\n    ani = FuncAnimation(fig, on_frame, frames=None, save_count=n_frames,\\n                        interval=500.0 / args.fps, blit=False, repeat=False)\\n    plt.show()\\n    return 0\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    raise SystemExit(main())\\n\"}", "tool_call_id": "call_00_953uTDMFqK5bf1rxfqRQ1826", "ui": {"group": null, "chip": "name", "summary": "", "preview": {"keys": ["✎path", "content"], "mode": "content"}, "header": "✓ wrote {path}", "form": "block", "body": "diff", "collapse": "long", "highlight": "", "chrome": "accent", "mutates": true, "undo": true}, "path_arg": "path"}
