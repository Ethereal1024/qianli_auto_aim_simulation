{"type": "tool_result", "timestamp": 1793188138.3029191, "id": "adc14c2da7a6", "tool_call_id": "call_00_E2uUQn7pOEdUIDMoSxv83936", "content": "105: # ---------------------------------------------------------------- geometry ---\n106: CAM_POS = np.array([0.0, 0.0, HEIGHT])\n107: BODY_POS = np.array([DISTANCE, 0.0, HEIGHT])\n108: R_WC = camera_rotation(CAM_YAW)\n109: N_FRAMES = max(2, round(SECONDS * FPS))\n110: \n111: track = TargetMotion()(\n112:     torch.linspace(0.0, SECONDS, N_FRAMES).unsqueeze(0),\n113:     \"complex\",\n114:     p0=torch.tensor([[DISTANCE, 0.0, HEIGHT]]),\n115:     yaw_0=torch.tensor([math.radians(YAW)]),\n116:     yaw_rate=torch.tensor([YAW_RATE]),\n117:     yaw_rate_amp=torch.tensor([0.5]),\n118:     yaw_rate_freq=torch.tensor([0.3]),\n119:     n_armors=N_ARMORS,\n120:     radius=torch.tensor([RADIUS]),\n121:     # sinus_amp=torch.tensor([[0.2, 0.2, 0.2]]),   # 上下左右摆动\n122:     # sinus_freq=torch.tensor([[0.2, 0.5, 0.3]]),\n123: )\n124: corners = track[\"corners\"][0].numpy()              # (frames, armors, 4, 3)\n125: centers = track[\"centers\"][0].numpy()\n126: body_pos = track[\"body_positions\"][0].numpy()\n127: body_rot = track[\"body_rotations\"][0].numpy()\n128: armor_rot = track[\"armor_rotations\"][0].numpy()\n129: \n130: # ------------------------------------------------------ figure and artists ---\n131: fig = plt.figure(figsize=(16.5, 5.2))\n132: ax_world = fig.add_subplot(1, 3, 1, projection=\"3d\")\n133: ax_armor = fig.add_subplot(1, 3, 2, projection=\"3d\")\n134: ax_image = fig.add_subplot(1, 3, 3)\n135: fig.subplots_adjust(left=0.04, right=0.98, bottom=0.10, top=0.85, wspace=0.15)\n136: \n137: world_frames = [triad(ax_world, \"W\", 0.5), triad(ax_world, \"C\", 0.3),\n138:                 triad(ax_world, \"B\", 0.25)]\n139: armor_frames = [triad(ax_armor, \"B\", 0.2)] + [\n140:     triad(ax_armor, f\"A{m}\", 0.1) for m in range(N_ARMORS)]\n141: world_plates = [line3d(ax_world, \"#666666\", 1.0) for _ in range(N_ARMORS)]\n142: armor_plates = [line3d(ax_armor, c, 1.2) for c in ARMOR_COLORS]\n143: fills, edges, tags = [], [], []\n144: for m, color in enumerate(ARMOR_COLORS):\n145:     fill = Polygon(np.zeros((4, 2)), closed=True, lw=0, alpha=0.35,\n146:                    facecolor=color)\n147:     ax_image.add_patch(fill)\n148:     fills.append(fill)\n149:     edges.append(ax_image.plot([], [], color=color, lw=1.2)[0])\n150:     tags.append(ax_image.text(0, 0, f\"A{m}\", fontsize=8))\n151: \n152: # limits from every frame of the track: the scale never moves\n153: cubes = np.vstack([corners.reshape(-1, 3), CAM_POS, np.zeros(3)])\n154: set_cube(ax_world, cubes, 0.1)\n155: set_cube(ax_armor, np.vstack([corners.reshape(-1, 3), BODY_POS]), 0.15)\n156: px_per_m = FX / DISTANCE                       # fixed zoom, no autozoom\n157: half = (RADIUS + 0.25) * px_per_m              # radius plus a margin, in px\n158: u_all, v_all = project(corners)\n159: ax_image.set_xlim(u_all.mean() - half, u_all.mean() + half)\n160: ax_image.set_ylim(v_all.mean() + half, v_all.mean() - half)   # v points down\n161: ax_image.set_aspect(\"equal\")\n162: ax_image.grid(alpha=0.3)\n163: ax_image.set_autoscale_on(False)\n164: \n165: for ax in (ax_world, ax_armor):\n166:     ax.set_xlabel(\"X fwd (m)\")\n167:     ax.set_ylabel(\"Y left (m)\")\n168:     ax.set_zlabel(\"Z up (m)\")\n169: ax_world.set_title(\"world, camera and body frames\")\n170: ax_armor.set_title(\"armor frames\")\n171: ax_image.set_title(f\"camera view at {DISTANCE:.1f} m \"\n172:                    f\"({IMAGE_W}x{IMAGE_H}, {px_per_m:.0f} px/m)\")\n173: fig.suptitle(\"W world, C camera, B body, A# armor;  x red, y green, z blue\",\n174:              fontsize=9)\n175: \n176: \n177: def update(index):\n178:     \"\"\"point every artist at frame index; nothing is created or cleared.\"\"\"\n179:     plate = corners[index]                         # (armors, 4, 3)\n180: \n181:     place(world_frames[0], np.zeros(3), np.eye(3))\n182:     place(world_frames[1], CAM_POS, R_WC.T)\n183:     place(world_frames[2], body_pos[index], body_rot[index])\n184:     place(armor_frames[0], body_pos[index], body_rot[index])\n... (showing lines 105-184 of 224; use offset=185 to continue)", "is_error": false, "diff": ""}
