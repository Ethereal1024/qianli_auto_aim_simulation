                           zorder=2)[0])\n+        art[\"tags\"].append(ax_img.text(0.0, 0.0, f\"A{m}\", fontsize=8, zorder=3))\n+\n+    apply_cube(ax, fixed[\"ax\"])\n+    apply_cube(ax2, fixed[\"ax2\"])\n+    ax_img.set_xlim(fixed[\"img\"][0], fixed[\"img\"][1])\n+    ax_img.set_ylim(fixed[\"img\"][2], fixed[\"img\"][3])\n+    ax_img.set_aspect(\"equal\")\n+    ax_img.grid(alpha=0.3)\n+    for a in (ax, ax2, ax_img):\n+        a.set_autoscale_on(False)      # one scale for the whole clip\n+    return art\n+\n+\n+def draw(index, out, args, art, n_armors):\n+    \"\"\"point every artist at frame *index*: nothing created, nothing cleared.\"\"\"\n     centers = out[\"centers\"][0, index].numpy()\n     corners = out[\"corners\"][0, index].numpy()          # (M, 4, 3)\n     body_rot = out[\"body_rotations\"][0, index].numpy()\n     armor_rot = out[\"armor_rotations\"][0, index].numpy()\n-    \n-    ax.clear()\n-    ax2.clear()\n-    ax_img.clear()\n-\n-    w, h = args.image_size\n+\n     cam_pos = np.array([0.0, 0.0, args.height])\n     body = np.array([args.distance, 0.0, args.height])\n     R_wc = camera_rotation(args.cam_yaw)\n-    u, v, depth = project(corners, R_wc, cam_pos, args.fx, args.fx, w / 2, h / 2)\n-    \n-    \n-    # a plate faces the camera when its normal points towards it\n+\n+    # panel 1: world, camera and body frames, true scale\n+    for k, (origin, rot, length) in enumerate((\n+            (np.zeros(3), np.eye(3), 0.5),\n+            (cam_pos, R_wc.T, 0.3),\n+            (body, body_rot, 0.25))):\n+        for j, line in enumerate(art[\"frames\"][k]):\n+            line.set_data_3d(*segment(origin, origin + length * rot[:, j]))\n+        art[\"labels\"][k].set_position_3d(origin)\n+    for m in range(n_armors):\n+        art[\"plates\"][m].set_data_3d(*np.vstack([corners[m], corners[m, 0]]).T)\n+\n+    # panel 2: body and armor frames, close up\n+    close = [(body, body_rot, 0.2)] + [(centers[m], armor_rot[m], 0.1)\n+                           