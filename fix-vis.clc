{"type": "tool_result", "timestamp": 1793182397.0598295, "id": "2e83e9fb9bf8", "tool_call_id": "call_00_SLzrfGjUhgzMwIakvcga0300", "content": "OK: command succeeded\nstdout:\n46:def camera_rotation(yaw_deg):\n47:    \"\"\"world -> camera rotation; positive yaw looks left.\"\"\"\n48:    c, s = np.cos(np.radians(yaw_deg)), np.sin(np.radians(yaw_deg))\n91:def triad(ax, label, length):\n97:def place(frame, origin, rot):\n107:BODY_POS = np.array([DISTANCE, 0.0, HEIGHT])\n115:    yaw_0=torch.tensor([math.radians(YAW)]),\n116:    yaw_rate=torch.tensor([YAW_RATE]),\n117:    yaw_rate_amp=torch.tensor([0.5]),\n118:    yaw_rate_freq=torch.tensor([0.3]),\n126:body_rot = track[\"body_rotations\"][0].numpy()\n136:world_frames = [triad(ax_world, \"W\", 0.5), triad(ax_world, \"C\", 0.3),\n137:                triad(ax_world, \"B\", 0.25)]\n138:armor_frames = [triad(ax_armor, \"B\", 0.2)] + [\n139:    triad(ax_armor, f\"A{m}\", 0.1) for m in range(N_ARMORS)]\n154:set_cube(ax_armor, np.vstack([corners.reshape(-1, 3), BODY_POS]), 0.15)\n180:    place(world_frames[0], np.zeros(3), np.eye(3))\n181:    place(world_frames[1], CAM_POS, R_WC.T)\n182:    place(world_frames[2], BODY_POS, body_rot[index])\n183:    place(armor_frames[0], BODY_POS, body_rot[index])\n186:        place(armor_frames[m + 1], centers[index, m], armor_rot[index, m])\n", "is_error": false, "diff": ""}
{"type": "tool_result", "timestamp": 1793182397.0657072, "id": "14523c191db6", "tool_call_id": "call_01_FTJqdnpqeHUXVC9W0bAq5036", "content": "OK: command succeeded\nstdout:\nimport math\n\nimport torch\nfrom torch import nn\n\nfrom diff_env.geometry import euler_to_rotmat\n\n\nclass BodyMotion(nn.Module):\n    def forward(self, t: torch.Tensor, params: dict):\n        bsz, sln = t.shape\n        device = t.device\n\n        def _get(key: str, shape: tuple, default: float = 0.0):\n            val = params.get(key, None)\n            if val is None:\n                return torch.full(shape, default, device=device, dtype=t.dtype)\n            if isinstance(val, torch.Tensor):\n                return val.to(device=device, dtype=t.dtype)\n            return torch.full(shape, float(val), device=device, dtype=t.dtype)\n\n        t_e = t.unsqueeze(-1)\n\n        p0 = _get(\"p0\", (bsz, 3))\n        sinus_amp = _get(\"sinus_amp\", (bsz, 3))\n        sinus_freq = _get(\"sinus_freq\", (bsz, 3))\n        rw_sigma = _get(\"rw_sigma\", (bsz, 3))\n\n        pos = p0.unsqueeze(1)\n\n        if sinus_amp.abs().sum() > 0:\n            pos = pos + sinus_amp.unsqueeze(1) * torch.sin(\n                2 * math.pi * sinus_freq.unsqueeze(1) * t_e\n            )\n\n        if rw_sigma.abs().sum() > 0:\n            increments = torch.randn(\n                bsz, sln, 3, device=device, dtype=t.dtype\n            ) * rw_sigma.unsqueeze(1)\n            pos = pos + torch.cumsum(increments, dim=1)\n\n        yaw_0 = _get(\"yaw_0\", (bsz,))\n        yaw_rate = _get(\"yaw_rate\", (bsz,))\n        yaw_rate_amp = _get(\"yaw_rate_amp\", (bsz,))\n        yaw_rate_freq = _get(\"yaw_rate_freq\", (bsz,))\n\n        pitch_0 = _get(\"pitch_0\", (bsz,))\n        pitch_amp = _get(\"pitch_amp\", (bsz,))\n        pitch_freq = _get(\"pitch_freq\", (bsz,))\n\n        roll_0 = _get(\"roll_0\", (bsz,))\n        roll_amp = _get(\"roll_amp\", (bsz,))\n        roll_freq = _get(\"roll_freq\", (bsz,))\n\n        yaw_rate = yaw_rate.unsqueeze(1)\n        if yaw_rate_amp.abs().sum() > 0:\n            yaw_rate = yaw_rate + yaw_rate_amp.unsqueeze(1) * torch.sin(\n                2 * math.pi * yaw_rate_freq.unsqueeze(1) * t\n            )\n        yaw = yaw_0.unsqueeze(1) + yaw_rate * t\n", "is_error": false, "diff": ""}
