{"type": "tool_result", "timestamp": 1793177154.4043355, "id": "c28d24719f7f", "tool_call_id": "call_00_jy7U0qHYvNUbq5ljNwgT0721", "content": "86: \n87: \n88: # ---------------------------------------------------------------- geometry --\n89: CAM_POS = np.array([0.0, 0.0, HEIGHT])\n90: BODY_POS = np.array([DISTANCE, 0.0, HEIGHT])\n91: R_WC = camera_rotation(CAM_YAW)\n92: N_FRAMES = max(2, int(round(SECONDS * FPS)))\n93: \n94: track = TargetMotion()(\n95:     torch.linspace(0.0, SECONDS, N_FRAMES).unsqueeze(0),\n96:     \"complex\",\n97:     p0=torch.tensor([[DISTANCE, 0.0, HEIGHT]]),\n98:     yaw_0=torch.tensor([math.radians(YAW)]),\n99:     yaw_rate=torch.tensor([3.0]),                  # rad/s, the target spins\n100:     n_armors=N_ARMORS,\n101:     radius=torch.tensor([RADIUS]),\n102: )\n103: corners = track[\"corners\"][0].numpy()              # (frames, armors, 4, 3)\n104: centers = track[\"centers\"][0].numpy()\n105: body_rot = track[\"body_rotations\"][0].numpy()\n106: armor_rot = track[\"armor_rotations\"][0].numpy()\n107: \n108: # -------------------------------------------------------------- one frame --\n109: fig = plt.figure(figsize=(16.5, 5.2))\n110: ax_world = fig.add_subplot(1, 3, 1, projection=\"3d\")\n111: ax_armor = fig.add_subplot(1, 3, 2, projection=\"3d\")\n112: ax_image = fig.add_subplot(1, 3, 3)\n113: fig.subplots_adjust(left=0.04, right=0.98, bottom=0.10, top=0.85, wspace=0.15)\n114: \n115: world_frames = [triad(ax_world, \"W\", 0.5), triad(ax_world, \"C\", 0.3),\n116:          triad(ax_world, \"B\", 0.25)]\n117: armor_frames = [triad(ax_armor, \"B\", 0.2)] + [triad(ax_armor, f\"A{m}\", 0.1)\n118:                                         for m in range(N_ARMORS)]\n119: world_plates = [ax_world.plot([], [], [], color=\"#666666\", lw=1.0)[0]\n120:                 for _ in range(N_ARMORS)]\n121: armor_plates = [ax_armor.plot([], [], [], color=c, lw=1.2)[0]\n122:                 for c in ARMOR_COLORS]\n123: fills, edges, tags = [], [], []\n124: for m, color in enumerate(ARMOR_COLORS):\n125:     fill = Polygon(np.zeros((4, 2)), closed=True, lw=0, alpha=0.35,\n126:                    facecolor=color)\n127:     ax_image.add_patch(fill)\n128:     fills.append(fill)\n129:     edges.append(ax_image.plot([], [], color=color, lw=1.2)[0])\n130:     tags.append(ax_image.text(0, 0, f\"A{m}\", fontsize=8))\n131: \n132: # limits from every frame of the track: the scale never moves\n133: cubes = np.vstack([corners.reshape(-1, 3), CAM_POS, np.zeros(3)])\n134: set_cube(ax_world, cubes, 0.1)\n135: set_cube(ax_armor, np.vstack([corners.reshape(-1, 3), BODY_POS]), 0.15)\n136: px_per_m = FX / DISTANCE                       # fixed zoom, no autozoom\n137: half = (RADIUS + 0.25) * px_per_m              # radius plus a margin, in px\n138: u_all, v_all = project(corners)\n139: ax_image.set_xlim(u_all.mean() - half, u_all.mean() + half)\n140: ax_image.set_ylim(v_all.mean() + half, v_all.mean() - half)   # v points down\n141: ax_image.set_aspect(\"equal\")\n142: ax_image.grid(alpha=0.3)\n143: ax_image.set_autoscale_on(False)\n144: \n145: for ax in (ax_world, ax_armor):\n146:     ax.set_xlabel(\"X fwd (m)\")\n147:     ax.set_ylabel(\"Y left (m)\")\n148:     ax.set_zlabel(\"Z up (m)\")\n149: ax_world.set_title(\"world, camera and body frames\")\n150: ax_armor.set_title(\"armor frames\")\n151: ax_image.set_title(f\"camera view at {DISTANCE:.1f} m \"\n152:                    f\"({IMAGE_W}x{IMAGE_H}, {px_per_m:.0f} px/m)\")\n153: fig.suptitle(\"W world, C camera, B body, A# armor;  x red, y green, z blue\",\n154:              fontsize=9)\n155: \n156: \n157: def update(index):\n158:     \"\"\"point every artist at frame index; nothing is created or cleared.\"\"\"\n159:     plate = corners[index]                         # (armors, 4, 3)\n160: \n161:     place(world_frames[0], np.zeros(3), np.eye(3))\n162:     place(world_frames[1], CAM_POS, R_WC.T)\n163:     place(world_frames[2], BODY_POS, body_rot[index])\n164:     place(armor_frames[0], BODY_POS, body_rot[index])\n165:     for m in range(N_ARMORS):\n166:         loop = closed(plate[m]).T                  # (3, 5), back to the start\n167:         place(armor_frames[m + 1], centers[index, m], armor_rot[index, m])\n168:         world_plates[m].set_data_3d(*loop)\n169:         armor_plates[m].set_data_3d(*loop)\n170: \n171:     u, v = project(plate)                          # (armors, 4)\n172:     normal = np.cross(plate[:, 1] - plate[:, 0], plate[:, 3] - plate[:, 0])\n173:     front = (normal * (CAM_POS - centers[index])).sum(-1) > 0\n174:     for m in range(N_ARMORS):\n175:         quad = closed(np.column_stack([u[m], v[m]]))\n176:         fills[m].set_xy(quad)\n177:         fills[m].set_visible(front[m])\n178:         edges[m].set_data(quad[:, 0], quad[:, 1])\n179:         edges[m].set_linestyle(\"-\" if front[m] else \":\")\n180:         tags[m].set_position((u[m].mean(), v[m].mean()))\n181: \n182: \n183: # --------------------------------------------------------------- playback --\n184: update(0)\n185: start = time.perf_counter()\n186: \n187: \n188: def animate(_tick):\n189:     index = min(int((time.perf_counter() - start) / SECONDS * N_FRAMES),\n190:                 N_FRAMES - 1)\n191:     update(index)\n192:     if index == N_FRAMES - 1:\n193:         animation.event_source.stop()\n194: \n195: \n196: animation = FuncAnimation(fig, animate, interval=1000.0 / FPS, repeat=False,\n197:                           cache_frame_data=False)\n198: plt.show()", "is_error": false, "diff": ""}
