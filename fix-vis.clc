{"type": "tool_result", "timestamp": 1792654003.3501081, "id": "6898baa113ce", "tool_call_id": "call_00_ET_CxcYPfOMsWr35rwhv4yG1146", "content": "OK: command succeeded\nstdout:\n\ndef world_to_camera(pts_world: np.ndarray, cam_pos: np.ndarray, R_wc: np.ndarray):\n    rel = np.asarray(pts_world, dtype=float) - cam_pos\n    return rel @ R_wc.T          # row-vector form of R_wc @ rel\n\n\ndef clip_near(poly_cam: np.ndarray, near: float = NEAR):\n    \"\"\"Sutherland-Hodgman clip of a polygon against the plane z = near.\"\"\"\n    out = []\n    n = len(poly_cam)\n    for i in range(n):\n        a, b = poly_cam[i], poly_cam[(i + 1) % n]\n        a_in, b_in = a[2] >= near, b[2] >= near\n        if a_in:\n            out.append(a)\n        if a_in != b_in:\n            d = (near - a[2]) / (b[2] - a[2])\n            out.append(a + d * (b - a))\n    return np.asarray(out, dtype=float) if out else None\n\n\ndef project_polygon(corners_world, cam_pos, R_wc, cam: Pinhole):\n    \"\"\"Project one world-space polygon; returns (u, v, depth) or None.\"\"\"\n    pts = clip_near(world_to_camera(corners_world, cam_pos, R_wc))\n    if pts is None or len(pts) < 3:\n        return None\n    u, v, z = cam.project(pts)\n    return u, v, z\n\n\n# --------------------------------------------------------------------------- #\n# scene\n# --------------------------------------------------------------------------- #\ndef make_scene(args) -> dict:\n    torch.manual_seed(args.seed)\n    tm = TargetMotion(armor_width=args.armor_width, armor_height=args.armor_height)\n\n    t = torch.linspace(0.0, args.duration, args.samples).unsqueeze(0)\n    offsets = np.resize(np.array([0.05, -0.05], dtype=np.float32), args.n_armors)\n\n    out = tm(\n        t,\n        \"complex\",\n        p0=torch.tensor([[args.distance, 0.0, args.height]]),\n        yaw_rate=torch.tensor([args.yaw_rate]),\n        n_armors=args.n_armors,\n        radius=torch.tensor([args.radius]),\n        armor_pitch=math.radians(args.armor_pitch_deg),\n        armor_height_offsets=torch.tensor(offsets).unsqueeze(0),\n        plate_orientation=args.plate_orientation,\n    )\n    return {\n        \"t\": t[0].numpy(),\n        \"body\": np.array([args.distance, 0.0, args.height]),\n        \"centers\": out[\"centers\"][0].detach().numpy(),      # (T, M, 3)\n        \"corners\": out[\"corners\"][0].detach().numpy(),      # (T, M, 4, 3)\n    }\n\n\n---\n\n# --------------------------------------------------------------------------- #\n# figure\n# --------------------------------------------------------------------------- #\ndef build_figure(scene: dict, cam: Pinhole, cam_pos: np.ndarray, cam_yaw: float,\n                 cam_pitch: float, n_frames: int, note: str = \"\"):\n    T, M = scene[\"corners\n... [1587 chars omitted] ...\n* (i / max(len(frame_idx) - 1, 1))\n        for m in range(M):\n            c = corners[k, m]\n            loop = np.vstack([c, c[0]])\n            ax_3d.plot(loop[:, 0], loop[:, 1], loop[:, 2], \"-\", color=colors[m],\n                       alpha=a, lw=1.6)\n    ax_3d.scatter(*centers[0].mean(axis=0), c=\"k\", marker=\"x\", s=40, alpha=0.7)\n    set_equal_3d(ax_3d, corners, pad=0.15)\n    _draw_axes_labels(ax_3d)\n    ax_3d.set_title(\"target close-up (equal aspect)\")\n    ax_3d.legend(loc=\"upper left\", fontsize=7)\n\n    # ---------------- panel 3: camera view ----------------------------------\n    alpha_of = {k: 1.0 - 0.72 * (i / max(len(frame_idx) - 1, 1))\n                for i, k in enumerate(frame_idx)}\n\n    def draw_view(ax, zoom):\n        for k in frame_idx:\n            for m in range(M):\n                res = project_polygon(corners[k, m], cam_pos, R_wc, cam)\n                if res is None:\n                    continue\n                u, v, _ = res\n                loop_u, loop_v = np.append(u, u[0]), np.append(v, v[0])\n                front = facing_dir[k, m] > 0\n                edge = facing_dir[k, m] == 0\n                if front:\n                    ax.fill(loop_u, loop_v, color=colors[m], alpha=0.20 * alpha_of[k])\n                    ax.plot(loop_u, loop_v, \"-\", color=colors[m], lw=1.2,\n                            alpha=alpha_of[k])\n                elif edge:\n                    ax.plot(loop_u, loop_v, \"--\", color=colors[m], lw=1.0,\n                            alpha=0.85 * alpha_of[k])\n                else:\n                    ax.plot(loop_u, loop_v, \":\", color=colors[m], lw=0.9,\n                            alpha=0.45 * alpha_of[k])\n                if zoom and front and k == frame_idx[-1]:\n                    ax.annotate(f\"A{m}\", (u.mean(), v.mean()),\n                                textcoords=\"offset points\", xytext=(5, 4),\n                                fontsize=8, color=colors[m])\n        ax.set_aspect(\"equal\")\n\n    draw_view(ax_img := fig.add_subplot(1, 3, 3), zoom=False)\n    ax_img.add_patch(Rectangle((0, 0), cam.width, cam.height, fill=False,\n                               ec=\"#444444\", lw=1.2))\n    ax_img.plot([cam.cx - 20, cam.cx + 20], [cam.cy, cam.cy], color=\"#888888\", lw=0.8)\n    ax_img.plot([cam.cx, cam.cx], [cam.cy - 20, cam.cy + 20], color=\"#888888\", lw=0.8)\n    ax_img.set_xlim(-60, cam.width + 60)\n    ax_img.set_ylim(cam.height + 60, -60)\n    ax_img.set_title(f\"camera view {cam.width}x{cam.height}  fx={cam.fx:.0f}\")\n    ax_img.grid(alpha=0.25)\n\n", "is_error": false, "diff": ""}
