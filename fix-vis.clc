{"type": "tool_result", "timestamp": 1792654004.7086837, "id": "e310f3d3537f", "tool_call_id": "call_00_yU9ksAOndYeoamNwXadA3031", "content": "OK: command succeeded\nstdout:\n    corners, centers = scene[\"corners\"], scene[\"centers\"]\n    T, M = corners.shape[:2]\n    assert corners.shape[2:] == (4, 3) and T > 1 and M >= 1\n    assert np.isfinite(corners).all() and np.isfinite(centers).all()\n\n    R_wc = camera_from_world(0.0, 0.0)\n    assert np.allclose(R_wc @ R_wc.T, np.eye(3), atol=1e-12)\n    assert np.isclose(np.linalg.det(R_wc), 1.0)\n\n    # convention: world +X -> camera +Z, world left -> camera -X, up -> -Y\n    fwd = world_to_camera(np.array([[1.0, 0.0, 0.0]]), np.zeros(3), R_wc)[0]\n    left = world_to_camera(np.array([[0.0, 1.0, 0.0]]), np.zeros(3), R_wc)[0]\n    up = world_to_camera(np.array([[0.0, 0.0, 1.0]]), np.zeros(3), R_wc)[0]\n    assert np.allclose(fwd, [0, 0, 1])\n    assert np.allclose(left, [-1, 0, 0])\n    assert np.allclose(up, [0, -1, 0])\n\n    # every armor centre sits in front of the camera and inside the frame\n    c_cam = world_to_camera(centers.reshape(-1, 3), cam_pos, R_wc)\n    assert (c_cam[:, 2] > 0.5).all(), \"armor behind the camera\"\n    u, v, _ = cam.project(c_cam)\n    assert (u > 0).all() and (u < cam.width).all()\n    assert (v > 0).all() and (v < cam.height).all()\n    assert np.abs(u - cam.cx).max() < 0.5 * cam.width\n\n    # positive camera yaw = look left (CCW about world +Z): the optical axis\n    # tips towards +Y, so a target on the left drifts right inside the image\n    probe = np.array([[3.0, 0.3, 0.0]])\n    R_yaw = camera_from_world(math.radians(30.0), 0.0)\n    axis = R_yaw[2]\n    assert axis[0] > 0.8 and axis[1] > 0.4\n    u_yaw = cam.project(world_to_camera(probe, cam_pos, R_yaw))[0][0]\n    u_ref = cam.project(world_to_camera(probe, cam_pos, R_wc))[0][0]\n    assert u_yaw > u_ref\n\n    # plate orientation: the normal must sit at the documented angle\n    normals = face_normals(corners)\n    nz = float(np.abs(normals[0, :, 2]).mean())\n    pitch_rad = math.radians(args.armor_pitch_deg)\n    expected_nz = math.sin(pitch_rad) if args.plate_orientation == \"vertical\" else math.cos(pitch_rad)\n    assert abs(nz - expected_nz) < 0.05, (nz, expected_nz)\n\n    # at t = 0 one plate faces the camera, one faces away, two are edge-on\n    cos0 = facing_cos(centers[0], normals[0], cam_pos)\n    front = int((cos0 > 0.2).sum())\n    back = int((cos0 < -0.2).sum())\n    assert front == 1 and back == 1 and M - front - back == 2, cos0\n    nearest = int(np.argmin(np.linalg.norm(centers[0] - cam_pos, axis=-1)))\n    assert cos0[nearest] > 0.2, \"the nearest plate must face the camera\"\n\n    # projected size follows the pinhole model a\n... [2439 chars omitted] ...\nl in enumerate(palette):\n        denom = 1.0 - col\n        t = np.clip(((1.0 - src) / denom).mean(axis=-1), 0.0, 1.0)\n        err = np.abs(src - (1.0 - t[:, None] * denom)).mean(axis=-1)\n        upd = err < best_err\n        best[upd] = m\n        best_err[upd] = err[upd]\n    good = best_err < 0.05\n    for m in range(M):\n        hits = int(((best == m) & good).sum())\n        assert hits > 10, f\"armor {m} never painted ({hits} px)\"\n        print(f\"  armor A{m} painted ..... {hits} px\")\n\n    print(\"geometry checks .......... ok\")\n    print(f\"plate normal elevation .. {math.degrees(math.asin(min(1.0, nz))):.1f}\"\n          f\" deg above horizon ({args.plate_orientation})\")\n\n\n# --------------------------------------------------------------------------- #\n# main\n# --------------------------------------------------------------------------- #\ndef build_parser() -> argparse.ArgumentParser:\n    p = argparse.ArgumentParser(\n        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter\n    )\n    p.add_argument(\"--out\", default=\"scripts/target_vis.png\")\n    p.add_argument(\"--dpi\", type=int, default=130)\n    p.add_argument(\"--frames\", type=int, default=5, help=\"time slices to draw\")\n    p.add_argument(\"--samples\", type=int, default=40)\n    p.add_argument(\"--duration\", type=float, default=2.0)\n    p.add_argument(\"--distance\", type=float, default=3.0)\n    p.add_argument(\"--height\", type=float, default=0.5, help=\"target/camera height (m)\")\n    p.add_argument(\"--radius\", type=float, default=0.3)\n    p.add_argument(\"--yaw-rate\", type=float, default=math.pi / 2)\n    p.add_argument(\"--n-armors\", type=int, default=4)\n    p.add_argument(\"--armor-width\", type=float, default=0.12)\n    p.add_argument(\"--armor-height\", type=float, default=0.06)\n    p.add_argument(\"--armor-pitch-deg\", type=float, default=15.0)\n    p.add_argument(\"--plate-orientation\", choices=(\"vertical\", \"horizontal\"),\n                   default=\"vertical\",\n                   help=\"vertical = upright armor, normal radial (default); \"\n                        \"horizontal = legacy env default, plates lie flat\")\n    p.add_argument(\"--cam-yaw-deg\", type=float, default=0.0)\n    p.add_argument(\"--cam-pitch-deg\", type=float, default=0.0)\n    p.add_argument(\"--fx\", type=float, default=800.0)\n    p.add_argument(\"--fy\", type=float, default=800.0)\n    p.add_argument(\"--image-size\", type=int, nargs=2, default=[1280, 1024],\n                   metavar=(\"W\", \"H\"))\n    p.add_argument(\"--seed\", type=int, default=42)\n", "is_error": false, "diff": ""}
