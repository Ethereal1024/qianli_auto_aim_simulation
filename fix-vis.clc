{"type": "tool_result", "timestamp": 1792654001.9321947, "id": "a07503548a51", "tool_call_id": "call_00_OW2xvqw4Z7VdoFfg12rL2247", "content": "OK: command succeeded\nstdout:\n        \"corners\": out[\"corners\"][0].detach().numpy(),      # (T, M, 4, 3)\n    }\n\n\ndef face_normals(corners: np.ndarray) -> np.ndarray:\n    \"\"\"Plate normal from the corner loop: cross(c1 - c0, c3 - c0).\"\"\"\n    n = np.cross(\n        corners[..., 1, :] - corners[..., 0, :],\n        corners[..., 3, :] - corners[..., 0, :],\n    )\n    return n / (np.linalg.norm(n, axis=-1, keepdims=True) + 1e-12)\n\n\ndef facing_cos(centers: np.ndarray, normals: np.ndarray,\n               cam_pos: np.ndarray) -> np.ndarray:\n    \"\"\"Cosine between plate normal and the unit vector towards the camera.\"\"\"\n    to_cam = cam_pos - centers\n    to_cam = to_cam / (np.linalg.norm(to_cam, axis=-1, keepdims=True) + 1e-12)\n    return np.einsum(\"...i,...i->...\", normals, to_cam)\n\n\ndef facing(centers: np.ndarray, normals: np.ndarray, cam_pos: np.ndarray) -> np.ndarray:\n    \"\"\"+1 front, -1 back, 0 edge-on (|cos| < 0.15).\"\"\"\n    cos = facing_cos(centers, normals, cam_pos)\n    sign = np.where(cos > 0.0, 1, -1)\n    return np.where(np.abs(cos) < 0.15, 0, sign)\n\n\ndef set_equal_3d(ax, pts: np.ndarray, pad: float = 0.10):\n    \"\"\"Cube limits + box aspect, so no axis gets stretched.\"\"\"\n    flat = pts.reshape(-1, 3)\n    lo, hi = flat.min(axis=0), flat.max(axis=0)\n    center = 0.5 * (lo + hi)\n    half = max(0.5 * float((hi - lo).max()), 1e-3) * (1.0 + pad)\n    ax.set_xlim(center[0] - half, center[0] + half)\n    ax.set_ylim(center[1] - half, center[1] + half)\n    ax.set_zlim(center[2] - half, center[2] + half)\n    ax.set_box_aspect((1.0, 1.0, 1.0))\n\n\ndef _draw_axes_labels(ax3d):\n    ax3d.set_xlabel(\"X fwd (m)\")\n    ax3d.set_ylabel(\"Y left (m)\")\n    ax3d.set_zlabel(\"Z up (m)\")\n\n\n# --------------------------------------------------------------------------- #\n# figure\n# --------------------------------------------------------------------------- #\ndef build_figure(scene: dict, cam: Pinhole, cam_pos: np.ndarray, cam_yaw: float,\n                 cam_pitch: float, n_frames: int, note: str = \"\"):\n    T, M = scene[\"corners\"].shape[:2]\n    n_frames = int(np.clip(n_frames, 1, T))\n    frame_idx = np.unique(np.linspace(0, T - 1, n_frames).round().astype(int))\n    R_wc = camera_from_world(cam_yaw, cam_pitch)\n\n    centers, corners = scene[\"centers\"], scene[\"corners\"]\n    normals = face_normals(corners)\n    facing_dir = facing(centers, normals, cam_pos)\n    colors = [BASE_COLORS[m % len(BASE_COLORS)] for m in range(M)]\n\n    fig = plt.figure(figsize=(17.0, 6.4))\n\n    # ---------------- panel 1: global overview (camera + target\n... [2686 chars omitted] ...\n                         alpha=0.45 * alpha_of[k])\n                if zoom and front and k == frame_idx[-1]:\n                    ax.annotate(f\"A{m}\", (u.mean(), v.mean()),\n                                textcoords=\"offset points\", xytext=(5, 4),\n                                fontsize=8, color=colors[m])\n        ax.set_aspect(\"equal\")\n\n    draw_view(ax_img := fig.add_subplot(1, 3, 3), zoom=False)\n    ax_img.add_patch(Rectangle((0, 0), cam.width, cam.height, fill=False,\n                               ec=\"#444444\", lw=1.2))\n    ax_img.plot([cam.cx - 20, cam.cx + 20], [cam.cy, cam.cy], color=\"#888888\", lw=0.8)\n    ax_img.plot([cam.cx, cam.cx], [cam.cy - 20, cam.cy + 20], color=\"#888888\", lw=0.8)\n    ax_img.set_xlim(-60, cam.width + 60)\n    ax_img.set_ylim(cam.height + 60, -60)\n    ax_img.set_title(f\"camera view {cam.width}x{cam.height}  fx={cam.fx:.0f}\")\n    ax_img.grid(alpha=0.25)\n\n    # zoom inset on the projected target region\n    uu, vv = [], []\n    for k in frame_idx:\n        for m in range(M):\n            res = project_polygon(corners[k, m], cam_pos, R_wc, cam)\n            if res is not None:\n                uu.append(res[0])\n                vv.append(res[1])\n    if uu:\n        uu, vv = np.concatenate(uu), np.concatenate(vv)\n        pad = 14.0\n        x0, x1 = uu.min() - pad, uu.max() + pad\n        y0, y1 = vv.min() - pad, vv.max() + pad\n        half = 0.5 * max(x1 - x0, y1 - y0)\n        cx, cy = 0.5 * (x0 + x1), 0.5 * (y0 + y1)\n        ax_zoom = ax_img.inset_axes([0.03, 0.03, 0.36, 0.36])\n        draw_view(ax_zoom, zoom=True)\n        ax_zoom.set_xlim(cx - half, cx + half)\n        ax_zoom.set_ylim(cy + half, cy - half)\n        ax_zoom.set_title(\"zoom on target\", fontsize=8)\n        ax_zoom.tick_params(labelsize=6)\n        ax_zoom.grid(alpha=0.25)\n        ax_zoom.set_facecolor(\"#f6f6f6\")\n        ax_img.add_patch(Rectangle((x0, y0), x1 - x0, y1 - y0, fill=False,\n                                   ec=\"#444444\", lw=1.0, ls=\"--\"))\n\n    fig.suptitle(\n        f\"{note}   solid = front face,  dashed = edge-on,  dotted = back face\"\n        f\"   (near clip {NEAR:.2f} m)\",\n        fontsize=9,\n    )\n    fig.tight_layout(rect=(0, 0, 1, 0.95))\n    return fig\n\n\n# --------------------------------------------------------------------------- #\n# self-test\n# --------------------------------------------------------------------------- #\ndef run_self_test(scene: dict, cam: Pinhole, cam_pos: np.ndarray, args) -> None:\n    corners, centers = scene[\"corners\"], scene[\"centers\"]\n", "is_error": false, "diff": ""}
