{"type": "tool_result", "timestamp": 1793176803.0114992, "id": "8fff2a2da0b3", "tool_call_id": "call_00_mQhufAPA7WmvnSu1RS3x2442", "content": "181:     clock = {\"t0\": None, \"i\": -1}\n182: \n183:     out = TargetMotion()(\n184:         t,\n185:         \"complex\",\n186:         p0=torch.tensor([[args.distance, 0.0, args.height]]),\n187:         yaw_0=torch.tensor([math.radians(args.yaw)]),\n188:         yaw_rate=torch.tensor([3]),\n189:         n_armors=n_armors,\n190:         radius=torch.tensor([args.radius]),\n191:     )\n192: \n193:     # one scale for the whole clip: limits from every frame of the trajectory\n194:     w, h = args.image_size\n195:     cam_pos = np.array([0.0, 0.0, args.height])\n196:     body = np.array([args.distance, 0.0, args.height])\n197:     R_wc = camera_rotation(args.cam_yaw)\n198:     all_corners = out[\"corners\"][0].numpy()                 # (T, M, 4, 3)\n199:     u_all, v_all, _ = project(all_corners, R_wc, cam_pos,\n200:                               args.fx, args.fx, w / 2, h / 2)\n201:     fixed = {\n202:         \"ax\": cube_limits(np.vstack([all_corners.reshape(-1, 3), cam_pos, np.zeros(3)]), 0.1),\n203:         \"ax2\": cube_limits(np.vstack([all_corners.reshape(-1, 3), body]), 0.15),\n204:     }\n205:     px_per_m = args.fx / args.distance        # fixed: no per-frame autozoom\n206:     half = (args.radius + 0.25) * px_per_m\n207:     cu, cv = u_all.mean(), v_all.mean()\n208:     fixed[\"img\"] = (cu - half, cu + half, cv + half, cv - half)   # v grows downwards\n209: \n210:     fig = plt.figure(figsize=(16.5, 5.2), dpi=args.dpi)\n211:     ax = fig.add_subplot(1, 3, 1, projection=\"3d\")\n212:     ax2 = fig.add_subplot(1, 3, 2, projection=\"3d\")\n213:     ax_img = fig.add_subplot(1, 3, 3)\n214:     fig.subplots_adjust(left=0.04, right=0.98, bottom=0.10, top=0.85, wspace=0.15)\n215:     for a in (ax, ax2):\n216:         label_axes(a)\n217:     ax.set_title(\"world, camera and body frames\")\n218:     ax2.set_title(\"armor frames\")\n219:     ax_img.set_title(f\"camera view at {args.distance:.1f} m \"\n220:                      f\"({w}x{h}, fx={args.fx:.0f}, {px_per_m:.0f} px/m)\")\n221:     fig.suptitle(\"W world, C camera, B body, A# armor;  x red, y green, z blue\",\n222:                  fontsize=9)\n223: \n224:     art = build(ax, ax2, ax_img, fixed, n_armors)\n225:     draw(0, out, args, art, n_armors)\n226: \n227:     from matplotlib.animation import FuncAnimation\n228: \n229:     def on_frame(_frame):\n230:         if clock[\"t0\"] is None:            # start the clock on the first frame\n231:             clock[\"t0\"] = time.perf_counter()\n232:         i = int((time.perf_counter() - clock[\"t0\"]) / args.duration * n_frames)\n233:         i = min(i, n_frames - 1)           # clamp: stop on the last frame\n234:         if i == clock[\"i\"]:                # wall clock has not moved a frame yet\n235:             return\n236:         clock[\"i\"] = i\n237:         draw(i, out, args, art, n_armors)\n238:         if i == n_frames - 1 and ani.event_source is not None:\n239:             ani.event_source.stop()\n240: \n241:     ani = FuncAnimation(fig, on_frame, frames=None, save_count=n_frames,\n242:                         interval=500.0 / args.fps, blit=False, repeat=False)\n243:     plt.show()\n244:     return 0\n245: \n246: \n247: if __name__ == \"__main__\":\n248:     raise SystemExit(main())", "is_error": false, "diff": ""}
